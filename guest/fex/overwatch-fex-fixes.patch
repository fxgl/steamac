 namespace FEX::HLE::x64 {
 void RegisterFD(FEX::HLE::SyscallHandler* Handler) {
+  // FEX write-protects host pages it translated code from (SMC tracking), so another process writing guest-writable
+  // memory gets EFAULT where hardware succeeds: wineserver doing NtWriteVirtualMemory for Overwatch's crash-reporter hook.
+  // Retry such a write through /proc/<pid>/mem, which writes through page protection the way ptrace does.
+  // shortcut: the target's FEX doesn't see this write, so code it already translated from the page stays stale;
+  // upgrade to a cross-process invalidation if a program patches code that has already run and then runs it again.
+  REGISTER_SYSCALL_IMPL_X64(process_vm_writev,
+                            [](FEXCore::Core::CpuStateFrame* Frame, pid_t pid, const struct iovec* local_iov, unsigned long liovcnt,
+                               const struct iovec* remote_iov, unsigned long riovcnt, unsigned long flags) -> uint64_t {
+    uint64_t Result = ::process_vm_writev(pid, local_iov, liovcnt, remote_iov, riovcnt, flags);
+    if (Result == -1 && errno == EFAULT && liovcnt == 1 && riovcnt == 1 && flags == 0 && local_iov[0].iov_len == remote_iov[0].iov_len) {
+      char Path[32];
+      snprintf(Path, sizeof(Path), "/proc/%d/mem", pid);
+      int fd = ::open(Path, O_WRONLY | O_CLOEXEC);
+      if (fd != -1) {
+        ssize_t Written = ::pwrite(fd, local_iov[0].iov_base, local_iov[0].iov_len, reinterpret_cast<off_t>(remote_iov[0].iov_base));
+        ::close(fd);
+        if (Written == static_cast<ssize_t>(local_iov[0].iov_len)) {
+          return Written;
+        }
+      }
+      errno = EFAULT;
+    }
+    SYSCALL_ERRNO();
+  });
+
