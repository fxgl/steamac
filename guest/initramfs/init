#!/bin/sh
# steamac boot stage: PID 1 of work/out/initramfs.cpio.gz (static busybox ash).
#
# Replaces, for the libkrun VM, everything that sits between the kernel and
# systemd on a real Steam Frame:
#   - Valve U-Boot / SPL A/B slot selection (splctl BOOT_ORDER/BOOT_x_LEFT),
#   - the stock mkinitcpio hooks `partsets`, `factory_reset`, `etc_overlay`
#     (work/frame/initrd/hooks/*, reproduced here line by line where it matters).
# and adds the VM adaptations that must not touch the pristine rootfs:
#   - read-only /usr overlay with the steamac layer (vdb) on top,
#   - synthesized /proc/cmdline (root=, rauc.slot=, steamos.efi=) bind-mounted
#     over the real one, because the launcher's cmdline cannot know the slot,
#     plus an untouched procfs at /run/steamac/proc for user-namespace
#     sandboxes (Flatpak/bubblewrap, see "switch_root"),
#   - os-release VARIANT_ID=steamdeck (bind mount, per booted slot),
#   - no-op /boot/kernelsetup.sh (bind mount),
#   - runtime unit masks in /run/systemd/{system,user} from the layer's list.
#
# A/B state ("bootenv") lives on the esp partition at /steamac/bootenv and has
# exactly the semantics of the Frame's splctl legacy U-Boot environment
# (observed by tracing the stock /usr/bin/splctl, see guest/layer/usr/bin/splctl):
#     BOOT_ORDER=A B       first entry = primary (splctl get-primary)
#     BOOT_A_LEFT=3        remaining boot attempts; 0 = bad (splctl get-state)
#     BOOT_B_LEFT=3
# Boot algorithm (RAUC U-Boot reference / Frame bootloader):
#     for slot in BOOT_ORDER: if BOOT_<slot>_LEFT > 0: decrement, boot it.
#     none left: reset all to 3 and boot the primary ("attempting to boot anyway").
#   The running system resets the counter to 3 via steamos-boot.service
#   (`steamos-bootconf set-mode booted` -> `splctl set-state <slot> good`) once
#   graphical.target is reached; a slot that fails 3 times in a row is skipped,
#   which is the rollback path after a bad update.
#   If this script cannot assemble slot X (missing/corrupt partition, missing
#   /sbin/init, partsets mismatch) it marks X bad (LEFT=0) and tries the next
#   slot in the same boot.
#
# Kernel cmdline knobs (all optional):
#   steamac.slot=A|B|stop  force a slot without consuming an attempt, or power off
#                         after provisioning/config (dev-only provision-only tests)
#   steamac.shell=1    interactive shell on the console just before switch_root
#   steamac.nomask=1   do not apply runtime unit masks
#   steamac.layer=/dev/vdX  layer device (default: autodetect erofs disk)
#   steamac.provision=1  first boot of a launcher-created disk: format and fill
#                      the blank partitions from the payload disk (see "provisioning")
#   steamac.config=1   apply the launcher's config payload disk (see "config payload")
#   steamac.ssh=0|1    0: no SSH server this boot (see "SSH switch"); 1/absent: as enabled
#   steamac.tz=ZONE    the Mac's time zone: /etc/localtime follows it (see "time zone")
#   steamac.clock24=0|1  Mac 12/24-hour format (layer mac-clock-format before Steam/Plasma)
#   steamac.share=PATH mount the launcher's virtio-fs "macshare" at PATH (see "shared folder")
#   init=PATH          init in the new root (default /sbin/init)

PATH=/bin
export PATH
umask 022

MAX_TRIES=3
STATE_REL=steamac/bootenv

msg()  { echo "steamac-init: $*"; echo "<6>steamac-init: $*" > /dev/kmsg 2>/dev/null; }
warn() { echo "steamac-init: WARNING: $*"; echo "<4>steamac-init: WARNING: $*" > /dev/kmsg 2>/dev/null; }

shell() {
    echo "steamac-init: $*"
    echo "steamac-init: starting a shell; exit it to continue."
    setsid cttyhack sh -i
}

fatal() {
    echo "steamac-init: FATAL: $*"
    echo "<2>steamac-init: FATAL: $*" > /dev/kmsg 2>/dev/null
    shell "boot failed"
    poweroff -f
}

# read-only bind mount (MS_BIND ignores MS_RDONLY, so remount explicitly)
bind_ro() { mount -o bind "$1" "$2" && mount -o remount,bind,ro "$2"; }

# ---------------------------------------------------------------- essentials
mkdir -p /proc /sys /dev /run /tmp /esp /efi /newroot
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o mode=0755,nosuid devtmpfs /dev
mount -t tmpfs -o mode=0755,nosuid,nodev run /run
mkdir -p /run/steamac /run/udev/rules.d /run/systemd/system /run/systemd/user

CMDLINE=$(cat /proc/cmdline)
# Split at the first standalone "--": kernel parameters before, init args after.
KARGS=; IARGS=; HAVE_DDASH=
for _a in $CMDLINE; do
    if [ -n "$HAVE_DDASH" ]; then IARGS="$IARGS $_a"
    elif [ "$_a" = -- ]; then HAVE_DDASH=1
    else KARGS="$KARGS $_a"
    fi
done
getarg() { # getarg key -> value of the last key=value kernel parameter
    _v=
    for _a in $KARGS; do
        case $_a in "$1="*) _v=${_a#*=} ;; esac
    done
    echo "$_v"
}
msg "kernel cmdline: $CMDLINE"

# ---------------------------------------------------------------- partitions
# Partitions are found by GPT name (PARTLABEL) from sysfs, no udev needed:
# /sys/class/block/<dev>/uevent carries PARTNAME= and PARTUUID=.
part_field() { # part_field <PARTLABEL> <FIELD> -> value (first match)
    for _u in /sys/class/block/*/uevent; do
        if grep -qx "PARTNAME=$1" "$_u"; then
            sed -n "s/^$2=//p" "$_u"
            return 0
        fi
    done
    return 1
}
part_dev() { _n=$(part_field "$1" DEVNAME) && [ -n "$_n" ] && echo "/dev/$_n"; }

wait_part() { # wait up to 30 s for a partition label to appear
    _i=0
    while ! part_dev "$1" >/dev/null; do
        [ $_i -ge 150 ] && return 1
        [ $_i -eq 0 ] && msg "waiting for partition '$1'..."
        sleep 0.2
        _i=$((_i + 1))
    done
    return 0
}

wait_part esp || fatal "no partition labelled 'esp' (is steamos.img attached as the first disk?)"
ESP_DEV=$(part_dev esp)

# ---------------------------------------------------------------- provisioning
# First boot of a disk the launcher created without Docker (contract "Docker-
# free disk provisioning", host = launcher, guest = this stage). The launcher
# writes the GPT (names/order/types/sizes of scripts/steps/40-disk.sh) and
# byte-exact copies of the OTA rootfs.img into rootfs-A and rootfs-B, leaves
# every other partition zeroed, and attaches a read-only payload disk with
# kernel parameter steamac.provision=1. This stage then does what 40-disk.sh
# does in the builder container, with the same tool versions (static mkfs.fat,
# mke2fs + the builder's /etc/mke2fs.conf, btrfstune in this initramfs):
#   esp, efi-A, efi-B  mkfs.fat -F 32 (efi-X: -s 1), label = partition name
#   var-A, var-B       mke2fs -t ext4 -L var-X; home: -O casefold -T huge -m 0
#   rootfs-B           btrfstune -f -u (own fsid; rootfs-A stays byte-exact)
#   efi-X              SteamOS/partsets/{all,self,other,shared,A,B}
#   esp                SteamOS/conf/{A,B}.conf by rootfs-A's own (static)
#                      /usr/lib/steamos-efi/steamos-bootconf, invoked exactly as
#                      40-disk.sh does; steamac/bootenv (A B, 3/3)
#   var-X              lib/overlays/etc/{upper,work}; upper: shadow (payload
#                      hash; none if empty = stock field, release disks),
#                      sshd enablement, machine-id (payload), hostname
#                      (only if the payload's differs from the image's);
#                      var-A: lib/steamos-atomupd/rootfs.caibx (payload)
# Payload v1: raw disk, uncompressed cpio newc archive at byte 0 whose first
# member is provision.env (KEY='value' lines, parsed, never sourced), then
# rootfs.caibx. Keys: PROVISION_VERSION=1, STEAMOS_BUILDID, STEAMOS_VERSION,
# STEAMOS_BRANCH, ROOTFS_SHA256, HOSTNAME, PASSWORD_HASH ($6$ crypt for user
# steamos), MACHINE_ID (32 hex), DISK_GUID, PARTUUID_<ESP|EFI_A|...|HOME>.
# Safety: nothing is formatted unless DISK_GUID and every PARTUUID_* equal the
# GPT of the disk holding esp, and rootfs-A carries the payload's BUILD_ID.
# Idempotent: the very last step writes esp:/steamac/provisioned
# ("<MACHINE_ID> <DISK_GUID>"); with that marker present every step is skipped
# and only "done" is reported again. A run interrupted before the marker redoes
# every step on the next boot (all of them are repeatable).
# Reporting: fx.progress lines "provision <pct> <text>", "provision done",
# "provision failed <reason>"; the same on hvc0 as "steamac-provision: ...".
# On failure the VM powers off (steamac.shell=1: after a shell); a half
# provisioned disk is never booted, and nothing loops.
PROV_NAMES="esp efi-A efi-B rootfs-A rootfs-B var-A var-B home"
PROV_MARK_REL=steamac/provisioned
PROV_TMP=/tmp/provision
PROV_PORT=

fx_find_port() { # the fx.progress virtio-console port (no udev: by sysfs name)
    [ -n "$PROV_PORT" ] && return 0
    _i=0
    while [ $_i -lt 10 ]; do
        for _n in /sys/class/virtio-ports/*/name; do
            [ -f "$_n" ] && [ "$(cat "$_n")" = fx.progress ] || continue
            _p=${_n%/name}
            [ -c "/dev/${_p##*/}" ] && { PROV_PORT=/dev/${_p##*/}; return 0; }
        done
        sleep 0.2
        _i=$((_i + 1))
    done
    warn "no fx.progress port; payload results are reported on the console only"
    return 1
}
fx_say() { # fx_say <topic> <words>: hvc0 "steamac-<topic>: <words>", fx.progress "<topic> <words>"
    _t=$1; shift
    echo "steamac-$_t: $*"
    echo "<6>steamac-$_t: $*" > /dev/kmsg 2>/dev/null
    [ -n "$PROV_PORT" ] && echo "$_t $*" > "$PROV_PORT" 2>/dev/null
    return 0
}
prov_say() { fx_say provision "$@"; }
prov_umount_all() {
    for _d in var-A var-B efi-A efi-B esp root; do
        grep -q " $PROV_TMP/mnt/$_d " /proc/mounts && umount "$PROV_TMP/mnt/$_d"
    done
    return 0
}
prov_fail() { # prov_fail <reason (one line)>
    echo "steamac-init: FATAL: disk provisioning failed: $*"
    echo "<2>steamac-init: FATAL: disk provisioning failed: $*" > /dev/kmsg 2>/dev/null
    prov_say "failed $*"
    sync
    prov_umount_all
    [ "$(getarg steamac.shell)" = 1 ] && shell "provisioning failed"
    echo "steamac-init: the disk is not provisioned; powering off (the next start with the payload retries)"
    poweroff -f
}
prov_cmd() { # prov_cmd <cmd...>: run quietly, show its output on failure
    _o=$("$@" 2>&1); _r=$?
    if [ $_r != 0 ]; then
        warn "$* failed (exit $_r):"
        echo "$_o" | while IFS= read -r _l; do [ -n "$_l" ] && warn "  $_l"; done
    fi
    return $_r
}
prov_key() { echo "$1" | tr 'a-z-' 'A-Z_'; }   # efi-A -> EFI_A
prov_uuid() { eval "echo \"\$P_PARTUUID_$(prov_key "$1")\""; }
prov_is_uuid() {
    echo "$1" | grep -qx '[0-9a-f]\{8\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{12\}'
}

find_payload() { # find_payload <first member> -> PAYLOAD_DEV: whole disk starting with a cpio newc header for it
    PAYLOAD_DEV=
    _i=0
    while [ $_i -lt 25 ]; do
        for _d in /sys/class/block/*; do
            grep -qx DEVTYPE=disk "$_d/uevent" 2>/dev/null || continue
            [ "$(dd if="/dev/${_d##*/}" bs=1 count=6 2>/dev/null)" = 070701 ] || continue
            [ "$(dd if="/dev/${_d##*/}" bs=1 skip=110 count=$((${#1} + 1)) 2>/dev/null | tr -d '\000')" = "$1" ] \
                || continue
            PAYLOAD_DEV=/dev/${_d##*/}
            return 0
        done
        sleep 0.2
        _i=$((_i + 1))
    done
    return 1
}

kv_parse() { # kv_parse <file> <var prefix> <key>...: KEY='value' lines -> <prefix><KEY>; 1 = bad quoting (KV_BAD)
    _f=$1; _pre=$2; shift 2
    KV_BAD=
    while IFS= read -r _l || [ -n "$_l" ]; do
        _l=${_l%"$(printf '\r')"}
        case $_l in ''|'#'*) continue ;; esac
        _k=${_l%%=*}; _v=${_l#*=}
        case " $* " in *" $_k "*) ;; *) continue ;; esac
        case $_v in "'"*"'") _v=${_v#"'"}; _v=${_v%"'"} ;; esac
        case $_v in *"'"*) KV_BAD=$_k; return 1 ;; esac
        eval "$_pre$_k=\$_v"
    done < "$_f"
    return 0
}

prov_parse() { # prov_parse <provision.env> -> P_<KEY>
    kv_parse "$1" P_ PROVISION_VERSION STEAMOS_BUILDID STEAMOS_VERSION STEAMOS_BRANCH ROOTFS_SHA256 HOSTNAME \
        PASSWORD_HASH MACHINE_ID DISK_GUID PARTUUID_ESP PARTUUID_EFI_A PARTUUID_EFI_B \
        PARTUUID_ROOTFS_A PARTUUID_ROOTFS_B PARTUUID_VAR_A PARTUUID_VAR_B PARTUUID_HOME \
        || prov_fail "payload: bad quoting in $KV_BAD"
    [ "$P_PROVISION_VERSION" = 1 ] || prov_fail "payload: unsupported PROVISION_VERSION '$P_PROVISION_VERSION'"
    [ -n "$P_STEAMOS_BUILDID" ] || prov_fail "payload: no STEAMOS_BUILDID"
    echo "$P_MACHINE_ID" | grep -qx '[0-9a-f]\{32\}' || prov_fail "payload: bad MACHINE_ID"
    # empty = no password: the stock shadow stays (release disks)
    case $P_PASSWORD_HASH in ''|'$6$'*) ;; *) prov_fail "payload: PASSWORD_HASH is not a SHA-512 crypt hash" ;; esac
    echo "$P_HOSTNAME" | grep -qx '[a-zA-Z0-9-]\{0,63\}' || prov_fail "payload: bad HOSTNAME"
    P_DISK_GUID=$(echo "$P_DISK_GUID" | tr 'A-F' 'a-f')
    prov_is_uuid "$P_DISK_GUID" || prov_fail "payload: bad DISK_GUID"
    for _n in $PROV_NAMES; do
        _k=$(prov_key "$_n")
        eval "P_PARTUUID_$_k=\$(echo \"\$P_PARTUUID_$_k\" | tr 'A-F' 'a-f')"
        prov_is_uuid "$(prov_uuid "$_n")" || prov_fail "payload: bad PARTUUID_$_k"
    done
}

prov_disk_guid() { # prov_disk_guid <disk> -> GPT disk GUID (lowercase) from the primary header
    _bs=$(cat "/sys/class/block/${1#/dev/}/queue/logical_block_size" 2>/dev/null)
    [ -n "$_bs" ] || _bs=512
    set -- $(dd if="$1" bs="$_bs" skip=1 count=1 2>/dev/null | od -An -tx1 -v -N72)
    [ $# = 72 ] && [ "$1$2$3$4$5$6$7$8" = 4546492050415254 ] || return 1   # "EFI PART"
    shift 56
    echo "$4$3$2$1-$6$5-$8$7-$9${10}-${11}${12}${13}${14}${15}${16}"
}
esp_disk() { # the whole disk holding esp, e.g. /dev/vda
    _p=$(readlink -f "/sys/class/block/${ESP_DEV#/dev/}")   # .../block/vda/vda1
    _p=${_p%/*}; echo "/dev/${_p##*/}"
}
set_shadow_hash() { # set_shadow_hash <src shadow> <dst> <hash>: dst = src with steamos's password field = hash
    awk -F: -v OFS=: -v h="$3" '$1 == "steamos" { $2 = h } { print }' "$1" > "$2.new" \
        && chmod 0600 "$2.new" \
        && awk -F: -v h="$3" '$1 == "steamos" && $2 == h { f = 1 } END { exit !f }' "$2.new" \
        && sync "$2.new" && mv -f "$2.new" "$2" \
        || { rm -f "$2.new"; return 1; }
}

prov_check_disk() { # payload must describe exactly the disk that holds esp
    _disk=$(esp_disk)
    _g=$(prov_disk_guid "$_disk") || prov_fail "$_disk has no readable primary GPT header"
    [ "$_g" = "$P_DISK_GUID" ] || prov_fail "payload DISK_GUID $P_DISK_GUID does not match $_disk ($_g)"
    # (own variable names: wait_part/part_dev use _i, _n, _u)
    _pc_num=1
    for _pc_name in $PROV_NAMES; do
        wait_part "$_pc_name" || prov_fail "partition '$_pc_name' not found"
        _pc_uuid=$(part_field "$_pc_name" PARTUUID | tr 'A-F' 'a-f')
        [ "$_pc_uuid" = "$(prov_uuid "$_pc_name")" ] \
            || prov_fail "PARTUUID of '$_pc_name' is $_pc_uuid, payload says $(prov_uuid "$_pc_name")"
        [ "$(part_field "$_pc_name" PARTN)" = $_pc_num ] || prov_fail "'$_pc_name' is not partition $_pc_num of $_disk"
        _pc_num=$((_pc_num + 1))
    done
    msg "provisioning: payload matches $_disk (GUID $_g)"
}

prov_partsets() { # prov_partsets <slot> <dir>: same algorithm/output as 40-disk.sh write_partsets
    _self=$1; _dir=$2
    [ "$_self" = A ] && _other=B || _other=A
    rm -rf "$_dir" && mkdir -p "$_dir" || return 1
    for _f in all self other shared A B; do : > "$_dir/$_f" || return 1; done
    for _n in $PROV_NAMES; do
        _u=$(prov_uuid "$_n")
        _set=${_n##*-}; _link=${_n%-*}
        [ "$_set" = "$_n" ] && _set=
        case $_set in
            "")        echo "$_link $_u" >> "$_dir/shared" ;;
            "$_self")  echo "$_link $_u" >> "$_dir/$_set"; echo "$_link $_u" >> "$_dir/self" ;;
            "$_other") echo "$_link $_u" >> "$_dir/$_set"; echo "$_link $_u" >> "$_dir/other" ;;
        esac
        echo "$_n $_u" >> "$_dir/all"
    done
}

prov_marker_state() { # -> "match" | "other" | "none" (esp unformatted or no marker)
    _st=none
    if mount -t vfat -o ro "$ESP_DEV" /esp 2>/dev/null; then
        if [ -f "/esp/$PROV_MARK_REL" ]; then
            [ "$(cat "/esp/$PROV_MARK_REL")" = "$1" ] && _st=match || _st=other
        fi
        umount /esp
    fi
    echo $_st
}

provision() {
    _t0=$(date +%s)
    fx_find_port
    if ! find_payload provision.env; then
        if [ "$(prov_marker_state x)" != none ]; then
            warn "steamac.provision=1 but no payload disk; the disk is already provisioned"
            prov_say done
            return 0
        fi
        prov_fail "steamac.provision=1 but no payload disk attached"
    fi
    msg "provisioning: payload on $PAYLOAD_DEV"
    rm -rf "$PROV_TMP"; mkdir -p "$PROV_TMP/payload" "$PROV_TMP/mnt"
    (cd "$PROV_TMP/payload" && cpio -i -d -m provision.env rootfs.caibx < "$PAYLOAD_DEV") 2>/dev/null
    [ -s "$PROV_TMP/payload/provision.env" ] || prov_fail "payload: cannot extract provision.env from $PAYLOAD_DEV"
    [ -s "$PROV_TMP/payload/rootfs.caibx" ] || prov_fail "payload: no rootfs.caibx"
    prov_parse "$PROV_TMP/payload/provision.env"
    msg "provisioning: SteamOS $P_STEAMOS_BUILDID ($P_STEAMOS_VERSION, branch '${P_STEAMOS_BRANCH:-?}')"
    prov_check_disk
    case $(prov_marker_state "$P_MACHINE_ID $P_DISK_GUID") in
        match) msg "provisioning: already done for this payload (esp:/$PROV_MARK_REL); skipping"
               rm -rf "$PROV_TMP"
               prov_say done
               return 0 ;;
        other) prov_fail "esp:/$PROV_MARK_REL belongs to another payload; refusing to reformat" ;;
    esac

    for _n in $PROV_NAMES; do eval "D_$(prov_key "$_n")=\$(part_dev \"\$_n\")"; done
    _m=$PROV_TMP/mnt
    for _d in root esp efi-A efi-B var-A var-B; do mkdir -p "$_m/$_d"; done
    # rootfs-A must be the payload's build and carry what the later steps use;
    # checked before anything is written. Unmounted again before btrfstune:
    # rootfs-B still has the same fsid, and btrfs-progs treats a device whose
    # fsid is mounted elsewhere as mounted.
    mount -t btrfs -o ro "$D_ROOTFS_A" "$_m/root" || prov_fail "cannot mount rootfs-A ($D_ROOTFS_A)"
    _bid=$(sed -n 's/^BUILD_ID=//p' "$_m/root/usr/lib/os-release" | tr -d '"')
    _ok=1
    [ -x "$_m/root/usr/lib/steamos-efi/steamos-bootconf" ] && [ -f "$_m/root/etc/shadow" ] || _ok=0
    umount "$_m/root"
    [ "$_bid" = "$P_STEAMOS_BUILDID" ] || prov_fail "rootfs-A is build '$_bid', the payload is for $P_STEAMOS_BUILDID"
    [ $_ok = 1 ] || prov_fail "rootfs-A lacks /usr/lib/steamos-efi/steamos-bootconf or /etc/shadow"

    prov_say "2 Formatting esp, efi-A, efi-B"
    prov_cmd mkfs.fat -F 32 -n esp "$D_ESP" || prov_fail "mkfs.fat esp"
    prov_cmd mkfs.fat -F 32 -s 1 -n efi-A "$D_EFI_A" || prov_fail "mkfs.fat efi-A"
    prov_cmd mkfs.fat -F 32 -s 1 -n efi-B "$D_EFI_B" || prov_fail "mkfs.fat efi-B"
    prov_say "10 Formatting var-A, var-B, home"
    # Absolute path: this busybox prefers its own applets for bare command
    # names, and it has a (minimal) mke2fs applet.
    export MKE2FS_CONFIG=/etc/mke2fs.conf
    prov_cmd /bin/mke2fs -t ext4 -q -F -L var-A "$D_VAR_A" || prov_fail "mke2fs var-A"
    prov_cmd /bin/mke2fs -t ext4 -q -F -L var-B "$D_VAR_B" || prov_fail "mke2fs var-B"
    prov_cmd /bin/mke2fs -t ext4 -q -F -L home -O casefold -T huge -m 0 "$D_HOME" || prov_fail "mke2fs home"
    prov_say "30 Giving rootfs-B its own filesystem ID"
    prov_cmd btrfstune -f -u "$D_ROOTFS_B" || prov_fail "btrfstune -f -u rootfs-B"

    prov_say "80 Writing the boot configuration"
    mount -t btrfs -o ro "$D_ROOTFS_A" "$_m/root" || prov_fail "cannot mount rootfs-A"
    for _d in esp efi-A efi-B; do
        mount -t vfat "$(eval echo "\$D_$(prov_key "$_d")")" "$_m/$_d" || prov_fail "cannot mount $_d"
    done
    for _d in var-A var-B; do
        mount -t ext4 "$(eval echo "\$D_$(prov_key "$_d")")" "$_m/$_d" || prov_fail "cannot mount $_d"
    done
    prov_partsets A "$_m/efi-A/SteamOS/partsets" || prov_fail "cannot write efi-A partsets"
    prov_partsets B "$_m/efi-B/SteamOS/partsets" || prov_fail "cannot write efi-B partsets"
    mkdir -p "$_m/esp/SteamOS/conf" "$_m/esp/steamac" || prov_fail "cannot create esp directories"
    for _s in A B; do
        prov_cmd "$_m/root/usr/lib/steamos-efi/steamos-bootconf" create --image "$_s" \
            --conf-dir "$_m/esp/SteamOS/conf" --efi-dir "$_m/efi-$_s" --set title "$_s" \
            || prov_fail "steamos-bootconf create --image $_s"
        [ -s "$_m/esp/SteamOS/conf/$_s.conf" ] || prov_fail "steamos-bootconf wrote no $_s.conf"
    done
    {
        echo "# steamac A/B boot state (splctl semantics); written by initramfs and /usr/bin/splctl"
        echo "BOOT_ORDER=A B"
        echo "BOOT_A_LEFT=$MAX_TRIES"
        echo "BOOT_B_LEFT=$MAX_TRIES"
    } > "$_m/esp/$STATE_REL" || prov_fail "cannot write esp:/$STATE_REL"

    prov_say "90 Writing the system settings"
    _host=$(cat "$_m/root/etc/hostname" 2>/dev/null)
    for _s in A B; do
        _v=$_m/var-$_s
        _up=$_v/lib/overlays/etc/upper
        install -d -m 0755 "$_v/lib" "$_v/lib/overlays" "$_v/lib/overlays/etc" "$_up" "$_v/lib/overlays/etc/work" \
            || prov_fail "cannot create var-$_s overlay directories"
        # shadow: stock file with the steamos password field filled in; no
        # hash in the payload (release disks) = no upper shadow, stock field
        if [ -n "$P_PASSWORD_HASH" ]; then
            set_shadow_hash "$_m/root/etc/shadow" "$_up/shadow" "$P_PASSWORD_HASH" \
                || prov_fail "cannot set the steamos password on var-$_s"
        fi
        # sshd enabled (kept across updates by atomic-update-keep.conf: *.wants/**)
        install -d -m 0755 "$_up/systemd" "$_up/systemd/system" "$_up/systemd/system/multi-user.target.wants" \
            && ln -sfn /usr/lib/systemd/system/sshd.service "$_up/systemd/system/multi-user.target.wants/sshd.service" \
            || prov_fail "cannot enable sshd on var-$_s"
        # the stock rootfs ships one fixed machine-id for every device
        echo "$P_MACHINE_ID" > "$_up/machine-id" && chmod 0444 "$_up/machine-id" \
            || prov_fail "cannot write machine-id on var-$_s"
        if [ -n "$P_HOSTNAME" ] && [ "$P_HOSTNAME" != "$_host" ]; then
            echo "$P_HOSTNAME" > "$_up/hostname" || prov_fail "cannot write hostname on var-$_s"
        fi
    done
    install -d -m 0755 "$_m/var-A/lib/steamos-atomupd" \
        && cp "$PROV_TMP/payload/rootfs.caibx" "$_m/var-A/lib/steamos-atomupd/rootfs.caibx" \
        || prov_fail "cannot store rootfs.caibx on var-A"

    # everything else on disk first, the completion marker last
    sync
    for _d in var-A var-B efi-A efi-B; do
        umount "$_m/$_d" || prov_fail "cannot unmount $_d"
    done
    echo "$P_MACHINE_ID $P_DISK_GUID" > "$_m/esp/$PROV_MARK_REL.new" && sync "$_m/esp/$PROV_MARK_REL.new" \
        && mv -f "$_m/esp/$PROV_MARK_REL.new" "$_m/esp/$PROV_MARK_REL" && sync \
        || prov_fail "cannot write esp:/$PROV_MARK_REL"
    umount "$_m/esp" || prov_fail "cannot unmount esp"
    umount "$_m/root"
    rm -rf "$PROV_TMP"
    msg "provisioning: complete in $(($(date +%s) - _t0)) s"
    prov_say "100 SteamOS disk ready"
    prov_say done
}

[ "$(getarg steamac.provision)" = 1 ] && provision

# ---------------------------------------------------------------- config payload
# Launcher settings that must reach the disk while the VM is off (contract
# "SSH policy", Config payload v1). With steamac.config=1 a read-only disk
# carries an uncompressed cpio newc archive whose first member is config.env
# (KEY='value' lines: CONFIG_VERSION=1, DISK_GUID = GPT disk GUID of the disk
# holding esp, PASSWORD_HASH = $6$ crypt for user steamos). The hash replaces
# steamos's password field in the /etc overlay upper shadow of var-A and var-B
# (an upper without shadow gets the slot's stock /etc/shadow - or the other
# slot's if that rootfs does not mount, e.g. after a failed update - with
# that field set). Reported as "config applied" / "config failed <reason>" on
# fx.progress, "steamac-config: ..." on hvc0. A failure never stops the boot:
# the launcher keeps the payload and retries on the next start. Runs after a
# first-boot provisioning if both payloads are attached.
CFG_TMP=/tmp/config
cfg_fail() {
    warn "config payload not applied: $*"
    for _d in var root; do grep -q " $CFG_TMP/$_d " /proc/mounts && umount "$CFG_TMP/$_d"; done
    rm -rf "$CFG_TMP"
    fx_say config "failed $*"
    return 1
}
apply_config() {
    fx_find_port
    find_payload config.env || { cfg_fail "steamac.config=1 but no config payload disk attached"; return 1; }
    rm -rf "$CFG_TMP"; mkdir -p "$CFG_TMP/payload" "$CFG_TMP/var" "$CFG_TMP/root"
    (cd "$CFG_TMP/payload" && cpio -i -d -m config.env < "$PAYLOAD_DEV") 2>/dev/null
    [ -s "$CFG_TMP/payload/config.env" ] || { cfg_fail "cannot extract config.env from $PAYLOAD_DEV"; return 1; }
    C_CONFIG_VERSION=; C_DISK_GUID=; C_PASSWORD_HASH=
    kv_parse "$CFG_TMP/payload/config.env" C_ CONFIG_VERSION DISK_GUID PASSWORD_HASH \
        || { cfg_fail "bad quoting in $KV_BAD"; return 1; }
    [ "$C_CONFIG_VERSION" = 1 ] || { cfg_fail "unsupported CONFIG_VERSION '$C_CONFIG_VERSION'"; return 1; }
    _disk=$(esp_disk)
    _g=$(prov_disk_guid "$_disk") || { cfg_fail "$_disk has no readable primary GPT header"; return 1; }
    C_DISK_GUID=$(echo "$C_DISK_GUID" | tr 'A-F' 'a-f')
    [ "$C_DISK_GUID" = "$_g" ] || { cfg_fail "payload DISK_GUID $C_DISK_GUID does not match $_disk ($_g)"; return 1; }
    case $C_PASSWORD_HASH in
        '$6$'*) ;;
        *) cfg_fail "PASSWORD_HASH is not a SHA-512 crypt hash"; return 1 ;;
    esac
    msg "config: payload on $PAYLOAD_DEV for $_disk"
    for _cs in A B; do
        _vd=$(part_dev "var-$_cs") && mount -t ext4 "$_vd" "$CFG_TMP/var" \
            || { cfg_fail "cannot mount var-$_cs"; return 1; }
        _v=$CFG_TMP/var
        _up=$_v/lib/overlays/etc/upper
        _src=$_up/shadow
        if [ ! -f "$_src" ]; then
            [ "$_cs" = A ] && _co=B || _co=A   # (other_of is defined further down)
            for _r in "rootfs-$_cs" "rootfs-$_co"; do
                _rd=$(part_dev "$_r") && mount -t btrfs -o ro "$_rd" "$CFG_TMP/root" 2>/dev/null \
                    && [ -f "$CFG_TMP/root/etc/shadow" ] && break
                grep -q " $CFG_TMP/root " /proc/mounts && umount "$CFG_TMP/root"
                warn "config: no stock /etc/shadow from $_r"
            done
            grep -q " $CFG_TMP/root " /proc/mounts || { cfg_fail "no stock /etc/shadow for var-$_cs"; return 1; }
            _src=$CFG_TMP/root/etc/shadow
            install -d -m 0755 "$_v/lib" "$_v/lib/overlays" "$_v/lib/overlays/etc" "$_up" "$_v/lib/overlays/etc/work" \
                || { cfg_fail "cannot create var-$_cs overlay directories"; return 1; }
        fi
        set_shadow_hash "$_src" "$_up/shadow" "$C_PASSWORD_HASH" \
            || { cfg_fail "cannot set the steamos password on var-$_cs"; return 1; }
        sync
        grep -q " $CFG_TMP/root " /proc/mounts && umount "$CFG_TMP/root"
        umount "$CFG_TMP/var" || { cfg_fail "cannot unmount var-$_cs"; return 1; }
        msg "config: steamos password set in var-$_cs (/etc overlay upper shadow)"
    done
    rm -rf "$CFG_TMP"
    fx_say config applied
}

[ "$(getarg steamac.config)" = 1 ] && apply_config

# ---------------------------------------------------------------- FAT check
# esp and efi-X are vfat. Linux sets the FAT "dirty" bit on every read-write
# mount and clears it on a clean umount; a VM that is killed while one is
# mounted read-write (systemd's /esp,/efi automounts, splctl, this script)
# leaves it set, and a crash mid-update can leave broken cluster chains. The
# kernel then reports "Volume was not properly unmounted" and, on the first
# inconsistent FAT entry, flips the volume read-only (errors=remount-ro), so
# A/B counters could no longer be written. Every boot therefore runs the
# static dosfstools checker in automatic repair mode on the unmounted
# partition first (-a: repair, -w: write changes immediately).
# fsck.fat exit status: 0 clean, 1 errors found (repaired with -a), other = failure.
# (The static build has no iconv modules; it falls back to its internal CP850
# table, so those notices and the version banner are dropped from the log.)
fat_check() { # fat_check <dev> <label>
    _out=$(fsck.fat -a -w "$1" 2>&1); _rc=$?
    _out=$(echo "$_out" | grep -vE '^Cannot initialize conversion|^Using internal CP850|^fsck\.fat [0-9]')
    case $_rc in
        0) msg "fsck.fat $2 ($1): clean" ;;
        1) warn "fsck.fat $2 ($1): errors repaired:"
           echo "$_out" | while IFS= read -r _l; do [ -n "$_l" ] && warn "  fsck.fat: $_l"; done ;;
        *) warn "fsck.fat $2 ($1) failed (exit $_rc):"
           echo "$_out" | while IFS= read -r _l; do [ -n "$_l" ] && warn "  fsck.fat: $_l"; done ;;
    esac
    return 0
}
fat_check "$ESP_DEV" esp

# ---------------------------------------------------------------- esp access
# The esp is mounted read-only for reading the state, and read-write only for
# the moment a write needs (mount, write, fsync, umount), so the dirty-bit
# window stays a few milliseconds per boot.
esp_rw_mount() {
    mount -t vfat -o rw,noatime,umask=0077,errors=remount-ro "$ESP_DEV" /esp \
        || { warn "cannot mount esp ($ESP_DEV) read-write"; return 1; }
    if grep -q " /esp vfat ro[, ]" /proc/mounts; then
        warn "esp ($ESP_DEV) came up read-only"; umount /esp; return 1
    fi
    return 0
}
esp_rw_umount() { # flush everything, then a clean umount clears the FAT dirty bit
    sync
    _ro=0; grep -q " /esp vfat ro[, ]" /proc/mounts && _ro=1
    umount /esp || { warn "cannot unmount esp"; return 1; }
    [ $_ro = 0 ] || { warn "esp was switched read-only by the kernel during the write (FAT errors)"; return 1; }
    return 0
}

# ---------------------------------------------------------------- A/B state
STATE=/esp/$STATE_REL
FACTORY_RESET_CFG=
esp_read() { # load state + factory-reset request with a read-only mount
    BOOT_ORDER="A B"; BOOT_A_LEFT=$MAX_TRIES; BOOT_B_LEFT=$MAX_TRIES
    if ! mount -t vfat -o ro,umask=0077 "$ESP_DEV" /esp; then
        warn "cannot mount esp ($ESP_DEV); using default A/B state"
        return
    fi
    if [ -f "$STATE" ]; then
        # Parse, never source: accept only well-formed lines.
        tr -d '\r' < "$STATE" > /tmp/bootenv
    else
        warn "no A/B state at esp:/$STATE_REL, using defaults"
        : > /tmp/bootenv
    fi
    for _cfg in /esp/efi/steamos/factory-reset/*.cfg; do
        [ -f "$_cfg" ] && { FACTORY_RESET_CFG=${_cfg#/esp}; break; }
    done
    umount /esp
    while IFS='=' read -r _k _v; do
        case "$_k" in
            BOOT_ORDER)
                case "$_v" in "A B"|"B A") BOOT_ORDER=$_v ;; *) warn "ignoring BOOT_ORDER='$_v'" ;; esac ;;
            BOOT_A_LEFT|BOOT_B_LEFT)
                case "$_v" in [0-9]) eval "$_k=\$_v" ;; *) warn "ignoring $_k='$_v'" ;; esac ;;
        esac
    done < /tmp/bootenv
}
# Atomic replace: write bootenv.new, fsync it, rename over bootenv, sync, umount.
# A crash at any point leaves either the old or the new complete file. If the
# esp cannot be written the chosen slot still boots (with a clear warning):
# the attempt counter then simply is not consumed this time.
save_state() {
    if ! esp_rw_mount; then
        warn "A/B state NOT saved (esp not writable); booting slot $SLOT anyway"
        return 0
    fi
    _ok=1
    mkdir -p "${STATE%/*}" \
        && {
            echo "# steamac A/B boot state (splctl semantics); written by initramfs and /usr/bin/splctl"
            echo "BOOT_ORDER=$BOOT_ORDER"
            echo "BOOT_A_LEFT=$BOOT_A_LEFT"
            echo "BOOT_B_LEFT=$BOOT_B_LEFT"
        } > "$STATE.new" \
        && sync "$STATE.new" \
        && mv -f "$STATE.new" "$STATE" \
        && sync "${STATE%/*}" \
        && grep -qx "BOOT_ORDER=$BOOT_ORDER" "$STATE" || _ok=0
    esp_rw_umount || _ok=0
    if [ $_ok = 1 ]; then
        msg "A/B state saved: BOOT_ORDER='$BOOT_ORDER' BOOT_A_LEFT=$BOOT_A_LEFT BOOT_B_LEFT=$BOOT_B_LEFT"
    else
        warn "A/B state NOT saved (write to esp:/$STATE_REL failed); booting slot $SLOT anyway"
    fi
    return 0
}
left_of() { eval echo "\$BOOT_${1}_LEFT"; }
set_left() { eval "BOOT_${1}_LEFT=$2"; }
other_of() { [ "$1" = A ] && echo B || echo A; }

pick_slot() { # sets SLOT, consumes one attempt; $1 = slot to exclude (optional)
    SLOT=
    for _s in $BOOT_ORDER; do
        [ "$_s" = "$1" ] && continue
        _l=$(left_of "$_s")
        if [ "$_l" -gt 0 ]; then
            set_left "$_s" $((_l - 1))
            SLOT=$_s
            msg "slot $SLOT selected (attempts left after this boot: $((_l - 1)), order '$BOOT_ORDER')"
            return 0
        fi
    done
    return 1
}

esp_read
msg "A/B state: BOOT_ORDER='$BOOT_ORDER' BOOT_A_LEFT=$BOOT_A_LEFT BOOT_B_LEFT=$BOOT_B_LEFT"
FORCED=$(getarg steamac.slot)
case "$FORCED" in
    A|B) SLOT=$FORCED; msg "slot $SLOT forced by steamac.slot= (counters untouched)" ;;
    stop) msg "steamac.slot=stop: provisioning/config complete; powering off (counters untouched)"
          sync
          poweroff -f ;;
    "")  if ! pick_slot; then
             warn "no slot has boot attempts left; resetting counters and booting the primary anyway"
             BOOT_A_LEFT=$MAX_TRIES; BOOT_B_LEFT=$MAX_TRIES
             pick_slot
         fi
         save_state ;;
    *)   fatal "invalid steamac.slot='$FORCED'" ;;
esac

# ---------------------------------------------------------------- per slot
# assemble_slot X: mount everything for slot X under /newroot; return 1 on a
# slot-specific failure (caller marks the slot bad and tries the other one).
assemble_slot() {
    _s=$1
    for _p in efi-$_s rootfs-$_s var-$_s; do
        wait_part "$_p" || { warn "slot $_s: partition '$_p' not found"; return 1; }
    done
    EFI_DEV=$(part_dev "efi-$_s"); ROOT_DEV=$(part_dev "rootfs-$_s"); VAR_DEV=$(part_dev "var-$_s")

    # -- partsets (stock hook `partsets`): efi-X:/SteamOS/partsets/* -> udev rules
    #    so that the real udevd creates /dev/disk/by-partsets/{self,other,A,B,shared,all}/*
    #    after switch_root (rules files survive because /run is moved, not recreated).
    fat_check "$EFI_DEV" "efi-$_s"
    mount -t vfat -o ro "$EFI_DEV" /efi || { warn "slot $_s: cannot mount $EFI_DEV"; return 1; }
    if [ ! -f /efi/SteamOS/partsets/self ]; then
        warn "slot $_s: efi-$_s has no SteamOS/partsets/self"; umount /efi; return 1
    fi
    rm -rf /run/steamac/partsets; mkdir -p /run/steamac/partsets
    rm -f /run/udev/rules.d/90-steamos-partsets-*.rules
    for _f in /efi/SteamOS/partsets/*; do
        [ -f "$_f" ] || continue
        _set=${_f##*/}
        tr -d '\r' < "$_f" > "/run/steamac/partsets/$_set"
        # identical to _udev_rules() in the stock hook ("other" hidden from udisks)
        [ "$_set" = other ] && _ud=1 || _ud=0
        while read -r _name _uuid; do
            [ -n "$_uuid" ] || continue
            echo "ENV{ID_PART_ENTRY_SCHEME}==\"gpt\", ENV{ID_PART_ENTRY_UUID}==\"$_uuid\", SYMLINK+=\"disk/by-partsets/$_set/$_name\", ENV{UDISKS_IGNORE}=\"$_ud\""
        done < "/run/steamac/partsets/$_set" > "/run/udev/rules.d/90-steamos-partsets-$_set.rules"
    done
    umount /efi
    EFI_UUID=$(sed -n 's/^efi //p' /run/steamac/partsets/self)
    _self_root=$(sed -n 's/^rootfs //p' /run/steamac/partsets/self)
    _real_root=$(part_field "rootfs-$_s" PARTUUID)
    _real_efi=$(part_field "efi-$_s" PARTUUID)
    if [ -n "$_real_root" ] && { [ "$_self_root" != "$_real_root" ] || [ "$EFI_UUID" != "$_real_efi" ]; }; then
        warn "slot $_s: efi-$_s partsets/self (rootfs $_self_root, efi $EFI_UUID) do not match the disk (rootfs $_real_root, efi $_real_efi)"
        return 1
    fi
    [ -n "$EFI_UUID" ] || { warn "slot $_s: no 'efi' entry in partsets/self"; return 1; }

    # -- rootfs (read-only btrfs, never written: keeps it byte-identical for RAUC/desync)
    mount -t btrfs -o ro "$ROOT_DEV" /newroot || { warn "slot $_s: cannot mount $ROOT_DEV"; return 1; }
    if [ ! -e "/newroot$INIT" ] && [ ! -L "/newroot$INIT" ]; then
        warn "slot $_s: $INIT missing in rootfs-$_s"; umount /newroot; return 1
    fi
    return 0
}

INIT=$(getarg init); [ -n "$INIT" ] || INIT=/sbin/init
if ! assemble_slot "$SLOT"; then
    [ -n "$FORCED" ] && fatal "forced slot $SLOT cannot be assembled"
    warn "slot $SLOT is unusable, marking it bad (BOOT_${SLOT}_LEFT=0)"
    set_left "$SLOT" 0
    BAD=$SLOT
    pick_slot "$BAD" || fatal "slot $BAD failed and no other slot has attempts left"
    save_state
    assemble_slot "$SLOT" || { set_left "$SLOT" 0; save_state; fatal "both slots failed to assemble"; }
fi
echo "$SLOT" > /run/steamac/slot

# ---------------------------------------------------------------- factory reset
# Stock hook `factory_reset`: a *.cfg in esp:/efi/steamos/factory-reset/
# (written by steamos-factory-reset-config) reformats var-A, var-B and home with
# the stock mke2fs options. The rootfs's own mke2fs is used (casefold support).
# Unlike the device we continue booting instead of rebooting (nothing but the
# read-only rootfs is mounted at this point). FACTORY_RESET_CFG was found while
# the esp was mounted read-only for the A/B state (see esp_read).
if [ -n "$FACTORY_RESET_CFG" ]; then
    msg "factory reset requested by $FACTORY_RESET_CFG: formatting var-A, var-B and home"
    mount -o bind /dev /newroot/dev && mount -t proc proc /newroot/proc || fatal "factory reset: cannot prepare chroot"
    for _p in var-A var-B; do
        _d=$(part_dev "$_p") && chroot /newroot /usr/bin/mke2fs -t ext4 -qF -L "$_p" "$_d" \
            || warn "factory reset: mke2fs $_p failed"
    done
    _d=$(part_dev home) && chroot /newroot /usr/bin/mke2fs -t ext4 -qF -L home -O casefold -T huge -m 0 "$_d" \
        || warn "factory reset: mke2fs home failed"
    umount /newroot/proc; umount /newroot/dev
    if esp_rw_mount; then
        rm -rf /esp/efi/steamos
        esp_rw_umount || warn "factory reset: esp:/efi/steamos may still request a reset"
    else
        warn "factory reset: esp not writable; the request in esp:/efi/steamos stays and repeats on the next boot"
    fi
fi

# ---------------------------------------------------------------- /var and /etc
# Stock hook `etc_overlay`, same paths and options.
mount -t ext4 "$VAR_DEV" /newroot/var || fatal "cannot mount var-$SLOT ($VAR_DEV)"
mkdir -p /newroot/var/lib/overlays/etc/upper /newroot/var/lib/overlays/etc/work
mount -t overlay overlay \
    -o "index=off,metacopy=off,lowerdir=/newroot/etc,upperdir=/newroot/var/lib/overlays/etc/upper,workdir=/newroot/var/lib/overlays/etc/work" \
    /newroot/etc || fatal "cannot mount the /etc overlay"

# ---------------------------------------------------------------- steamac layer
LAYER=/run/steamac/layer
mkdir -p "$LAYER"
LAYER_DEV=$(getarg steamac.layer)
if [ -z "$LAYER_DEV" ]; then
    for _d in /sys/class/block/*; do
        grep -qx DEVTYPE=disk "$_d/uevent" 2>/dev/null || continue
        # erofs superblock magic 0xE0F5E1E2 at byte 1024
        _m=$(dd if="/dev/${_d##*/}" bs=1024 skip=1 count=1 2>/dev/null | od -An -tx1 -N4 | tr -d ' \n')
        [ "$_m" = e2e1f5e0 ] && { LAYER_DEV=/dev/${_d##*/}; break; }
    done
fi
if [ -n "$LAYER_DEV" ] && mount -t erofs -o ro "$LAYER_DEV" "$LAYER" \
        && [ -f "$LAYER/usr/lib/steamac/layer-release" ]; then
    msg "steamac layer $LAYER_DEV: $(cat "$LAYER/usr/lib/steamac/layer-release")"
    # Read-only /usr overlay: layer above the pristine slot /usr.
    mount -t overlay overlay -o "ro,lowerdir=$LAYER/usr:/newroot/usr" /newroot/usr \
        || fatal "cannot mount the /usr overlay"
    # Current slot: Frame bootloader/firmware flasher -> no-op (see layer file).
    if [ -f /newroot/boot/kernelsetup.sh ]; then
        bind_ro "$LAYER/usr/lib/steamac/kernelsetup.sh" /newroot/boot/kernelsetup.sh \
            || warn "cannot neutralise /boot/kernelsetup.sh"
    fi
    HAVE_LAYER=1
else
    warn "steamac layer not found/mountable (dev='$LAYER_DEV'); booting the bare Frame userspace"
    mountpoint_layer=$(grep -c " $LAYER " /proc/mounts)
    [ "$mountpoint_layer" -gt 0 ] && umount "$LAYER"
    HAVE_LAYER=
fi

# ---------------------------------------------------------------- os-release
# The Frame Steam client enters VR mode for VARIANT_ID=vr. Rewrite it per boot
# from the booted slot's own os-release (keeps BUILD_ID/VERSION_ID current after
# updates; steamos-atomupd reads its variant from /etc/steamos-atomupd/manifest.json,
# so the update channel stays "vr").
_osr=/newroot/etc/os-release
[ -f "$_osr" ] || _osr=/newroot/usr/lib/os-release
if [ -f "$_osr" ]; then
    { grep -v '^VARIANT_ID=' "$_osr"; echo 'VARIANT_ID="steamdeck"'; } > /run/steamac/os-release
    for _t in /newroot/usr/lib/os-release /newroot/etc/os-release; do
        [ -f "$_t" ] && [ ! -L "$_t" ] && bind_ro /run/steamac/os-release "$_t"
    done
    # The launcher tags its crash reports with this line (steamac-init: rootfs-X BUILD_ID=...).
    msg "rootfs-$SLOT BUILD_ID=$(sed -n 's/^BUILD_ID=//p' "$_osr" | tr -d '"') VERSION_ID=$(sed -n 's/^VERSION_ID=//p' "$_osr" | tr -d '"')"
else
    warn "no os-release in rootfs-$SLOT"
fi

# ---------------------------------------------------------------- time zone
# Contract "Mac time": with Settings > General "Use the Mac's time zone" the launcher
# passes steamac.tz=<the Mac's IANA zone> on every boot. /etc/localtime - what
# timedatectl, Steam's Settings > Time and date > Time zone (steamos-set-timezone) and
# Steam's clock use - follows the Mac until it is changed inside SteamOS:
# /etc/steamac/mac-timezone holds the zone last seen applied here, and a different
# /etc/localtime is the user's choice, which stays (until it is the Mac's zone again).
# Both live in var-X's /etc overlay upper.
MAC_TZ=$(getarg steamac.tz)
if [ -n "$MAC_TZ" ]; then
    _state=/newroot/etc/steamac/mac-timezone
    _cur=$(readlink /newroot/etc/localtime 2>/dev/null)
    _cur=${_cur#*zoneinfo/}
    _last=$(cat "$_state" 2>/dev/null)
    case $MAC_TZ in
        *[!A-Za-z0-9_+/-]*|/*|*..*)
            warn "ignoring steamac.tz='$MAC_TZ'" ;;
        *)
            if [ ! -f "/newroot/usr/share/zoneinfo/$MAC_TZ" ]; then
                warn "steamac.tz=$MAC_TZ: no such zone in rootfs-$SLOT; time zone stays ${_cur:-unset}"
            elif [ -n "$_last" ] && [ "$_cur" != "$_last" ]; then
                msg "time zone ${_cur:-unset} chosen in SteamOS (Mac: $MAC_TZ), kept"
            else
                _set=1
                if [ "$_cur" != "$MAC_TZ" ]; then
                    if ln -sfn "../usr/share/zoneinfo/$MAC_TZ" /newroot/etc/localtime; then
                        msg "time zone $MAC_TZ (the Mac's; was ${_cur:-unset})"
                    else
                        warn "cannot set /etc/localtime to $MAC_TZ"; _set=0
                    fi
                fi
                if [ $_set = 1 ] && [ "$_last" != "$MAC_TZ" ]; then
                    { mkdir -p /newroot/etc/steamac && echo "$MAC_TZ" > "$_state"; } || warn "cannot write $_state"
                fi
            fi ;;
    esac
fi

# ---------------------------------------------------------------- cmdline
# What U-Boot would have passed ("%s %s %s init=/sbin/init rauc.slot=%c noresume
# rootwait earlycon %s", root=PARTLABEL=rootfs-X, steamos.efi=PARTUUID=<efi-X>).
# Consumers: splctl get-current, kernelsetup.sh, anything grepping rauc.slot=.
# Kernel parameters go before the first standalone "--" (libkrun always appends
# one); anything after it belongs to init and is kept verbatim at the end.
# steamac.ssh=0 adds systemd.ssh_auto=no: systemd-ssh-generator then creates
# none of its sshd-unix-local/-vsock/-unix-export sockets (see "SSH switch").
SSH=$(getarg steamac.ssh)
case $SSH in 0|1|"") ;; *) warn "ignoring steamac.ssh='$SSH' (0 or 1)"; SSH= ;; esac
_keep=
for _a in $KARGS; do
    case $_a in
        root=*|rauc.slot=*|steamos.efi=*|init=*) ;;
        systemd.ssh_auto=*) [ "$SSH" = 0 ] || _keep="$_keep $_a" ;;
        *) _keep="$_keep $_a" ;;
    esac
done
[ "$SSH" = 0 ] && _keep="$_keep systemd.ssh_auto=no"
echo "${_keep# } root=PARTLABEL=rootfs-$SLOT rauc.slot=$SLOT steamos.efi=PARTUUID=$EFI_UUID init=$INIT${HAVE_DDASH:+ --$IARGS}" > /run/steamac/cmdline

# ---------------------------------------------------------------- unit masks
# /run/systemd/{system,user}/<unit> -> /dev/null ("masked-runtime"): beats the
# vendor units and the /etc enablement symlinks, lives only for this boot.
if [ -n "$HAVE_LAYER" ] && [ "$(getarg steamac.nomask)" != 1 ]; then
    _n=0
    for _f in "$LAYER"/usr/lib/steamac/masks.d/*.list; do
        [ -f "$_f" ] || continue
        while read -r _scope _unit _rest; do
            case "$_scope" in system|user) ;; *) continue ;; esac
            ln -sfn /dev/null "/run/systemd/$_scope/$_unit" && _n=$((_n + 1))
        done < "$_f"
    done
    msg "runtime-masked $_n units"
fi

# ---------------------------------------------------------------- SSH switch
# Contract "SSH policy": the launcher passes steamac.ssh=0|1 on every boot
# (release app default 0). 0 = no SSH server at all this boot: runtime masks
# (independent of steamac.nomask) for the rootfs's sshd.service and every unit
# systemd-ssh-generator (systemd 257) can create, on top of systemd.ssh_auto=no
# above. 1 or absent = sshd as enabled in /etc (var-X upper enables it).
if [ "$SSH" = 0 ]; then
    for _unit in sshd.service sshd@.service sshd.socket \
                 sshd-unix-local.socket sshd-unix-local@.service sshd-vsock.socket sshd-vsock@.service \
                 sshd-unix-export.socket sshd-unix-export@.service sshd-extra.socket sshd-extra@.service \
                 sshd-generated@.service; do
        ln -sfn /dev/null "/run/systemd/system/$_unit"
    done
    msg "steamac.ssh=0: SSH server disabled for this boot (sshd units runtime-masked)"
fi

# ---------------------------------------------------------------- shared folder
# Contract "shared folder": with Settings > Advanced "Shared folder" the launcher adds
# a virtio-fs device tagged macshare (krun_add_virtiofs4) and passes
# steamac.share=<guest path>. A runtime mount unit (lives only for this boot, like
# the masks above) mounts it there; systemd creates the directory. Wanted, not
# required, by local-fs.target: a boot without the device still completes.
SHARE=$(getarg steamac.share)
if [ -n "$SHARE" ]; then
    _ok=1
    case $SHARE in
        /*/|/|*[!A-Za-z0-9/_.-]*) _ok=0 ;;
        /*) for _c in $(IFS=/; echo $SHARE); do
                case $_c in .|..) _ok=0 ;; esac
            done ;;
        *) _ok=0 ;;
    esac
    if [ $_ok = 1 ]; then
        # systemd-escape --path: strip the leading /, "-" -> \x2d, "/" -> "-", a leading "." -> \x2e
        _unit=$(printf %s "${SHARE#/}" | sed 's/-/\\x2d/g; s,/,-,g; s/^\./\\x2e/').mount
        mkdir -p /run/systemd/system/local-fs.target.wants
        cat > "/run/systemd/system/$_unit" <<EOF
[Unit]
Description=Shared Mac folder (steamac.share)
Documentation=https://github.com/fxgl/steamac

[Mount]
What=macshare
Where=$SHARE
Type=virtiofs
Options=defaults
TimeoutSec=15
EOF
        ln -sfn "../$_unit" "/run/systemd/system/local-fs.target.wants/$_unit"
        msg "shared folder: virtio-fs macshare at $SHARE ($_unit)"
    else
        warn "ignoring steamac.share='$SHARE' (absolute path, no . or .. components, [A-Za-z0-9/_.-] only)"
    fi
fi

# ---------------------------------------------------------------- switch_root
[ "$(getarg steamac.shell)" = 1 ] && shell "steamac.shell=1: /newroot is assembled"

# The synthesized cmdline is bound while /proc is still ours (the remount step
# of bind_ro needs /proc/mounts); `mount --move` carries the submount along.
bind_ro /run/steamac/cmdline /proc/cmdline || warn "cannot bind synthesized cmdline"
# A procfs with a file mounted over one of its entries is not "fully visible",
# and the kernel lets an unprivileged user namespace mount a new procfs only
# while some procfs in its mount namespace is (fs/namespace.c
# mnt_already_visible). bubblewrap mounts one for every Flatpak app (Discover's
# apps: "bwrap: Can't mount proc on /newroot/proc: Operation not permitted"),
# as does `unshare --mount-proc`. This untouched instance, moved along with
# /run, keeps that possible; its flags match what bwrap/unshare request.
mkdir -p /run/steamac/proc
mount -t proc -o nosuid,nodev,noexec proc /run/steamac/proc || warn "cannot mount /run/steamac/proc (Flatpak apps will not start)"
for _m in dev proc sys run; do
    mount -o move "/$_m" "/newroot/$_m" || fatal "cannot move /$_m"
done
msg "switching to rootfs-$SLOT ($ROOT_DEV), init $INIT"
exec switch_root /newroot "$INIT"
