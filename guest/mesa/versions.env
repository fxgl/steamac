# Pinned inputs for the guest Venus (virtio) Vulkan ICD build. Sourced by build.sh.

# Mesa main at the commit that adds "venus: honor the virtio-gpu blob alignment"
# (MR !44783). Same 26.3.0-devel cycle as the image's deckard-mesa 26.3.0_devel+git8aa73b4b19
# (8aa73b4b19 is a Valve-internal commit that does not exist in upstream Mesa).
MESA_URL=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_COMMIT=4cf0989083d25b92d02c6fef2bed934ad77b4ecd

# Mesa's subprojects/venus-protocol.wrap at that commit: tag v1.1.3 (pinned to its commit).
VENUS_PROTOCOL_URL=https://gitlab.freedesktop.org/virgl/venus-protocol.git
VENUS_PROTOCOL_COMMIT=ca19b6358d7cc491bc3e4de76f04c6700876a8fa

# aarch64 build: Steam Frame userspace (holo-deckard base-devel, BUILD_ID 20260922.6101926, arm64).
AARCH64_IMAGE=ghcr.io/aeongdesu/holo-deckard@sha256:fffad552f890c6439454f9ab41c2e7406bb3f64f011b0ac060bf81a86853dde0

# x86_64 + i386 build: Arch Linux base (amd64) re-pointed at Valve's SteamOS 3.8 x86_64 repos
# (glibc 2.41, gcc 15.1.1 — same as the fex-mesa provider: glibc 2.41, libstdc++.so.6.0.34).
X86_IMAGE=docker.io/library/archlinux@sha256:210f84bb93c4865c480604717ae4bc225920ee39ac2076b7a3cffeed4e28b704
STEAMOS_X86_MIRROR=https://steamdeck-packages.steamos.cloud/archlinux-mirror
STEAMOS_X86_BRANCH=3.8
# Valve's package-signing keyring ("GitLab CI Package Builder <ci-package-builder-1@steamos.cloud>");
# the sha256 pin is the trust anchor for SigLevel=Required on the SteamOS repos.
HOLO_KEYRING_PKG=holo-3.8/os/x86_64/holo-keyring-20250801-1-any.pkg.tar.zst
HOLO_KEYRING_SHA256=a5efa4f9c161ce9607fd9dfcccaf2a587baa9acd35eae04d3c01d967dddc9722

# Helper image (source fetch, verification chroot). alpine:3.22 index digest; run with --platform linux/arm64.
TOOLS_IMAGE=docker.io/library/alpine@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

# In-guest locations.
FEX_PROVIDER=/usr/share/guestos/fex-mesa
