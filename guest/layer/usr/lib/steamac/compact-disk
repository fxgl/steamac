#!/bin/bash
# The bash -c bodies below run as steamos and expand their own arguments.
# shellcheck disable=SC2016
# Reclaim host SSD space for a sparse steamos.img: TRIM free blocks in SteamOS so
# virtio-blk DISCARD punches holes (imago F_PUNCHHOLE on macOS). Invoked as root by
# fx-compact-disk.service when the session agent drops compact-request.
set -euo pipefail
DIR=/home/steamos/.local/share/steamac
REQ=$DIR/compact-request
RES=$DIR/compact-result
# The directory is controlled by steamos. Never access it with root privileges,
# including after a type check (the user can replace paths at any time).
ID=$(runuser -u steamos -- bash -c '
	req=$1
	if [[ ! -f $req || -L $req ]]; then
		rm -f -- "$req"
		exit 1
	fi
	# O_NONBLOCK also handles a regular file replaced with a FIFO after the check.
	id=$(dd if="$req" iflag=nonblock bs=128 count=1 status=none | tr -cd "A-Za-z0-9-" | head -c 32)
	rm -f -- "$req"
	printf "%s" "$id"
' bash "$REQ") || exit 1
write_result() {
	printf '%s %s %s\n' "$1" "${ID:-unknown}" "$2" |
		runuser -u steamos -- bash -c '
			set -eu
			tmp=$(mktemp "$1/compact-result.XXXXXXXX")
			trap '\''rm -f -- "$tmp"'\'' EXIT
			cat >"$tmp"
			mv -fT -- "$tmp" "$2"
		' bash "$DIR" "$RES"
}
if [[ -z $ID ]]; then
	write_result failed empty-id
	exit 1
fi
# Games live on home. Trim /var too when it is a separate mount.
status=0
trimmed=0
for mp in /home /var; do
	findmnt -n "$mp" >/dev/null 2>&1 || continue
	if fstrim -v "$mp"; then
		trimmed=$((trimmed + 1))
	else
		status=1
	fi
done
# fstrim output belongs in the journal, not in localized launcher messages.
if [[ $status -eq 0 && $trimmed -gt 0 ]]; then
	write_result ok trimmed
else
	status=1
	write_result failed fstrim-failed
fi
exit "$status"
