#!/usr/bin/python3
"""Apply the host-advertised VirtIO playback map before WirePlumber starts."""
import os
from pathlib import Path
import re
import subprocess
import tempfile

POSITIONS = set("MONO FL FR RL RR FC LFE SL SR RC FLC FRC RLC RRC TC TFL TFR TFC TRL TRR TRC TFLC TFRC TSL TSR LLFE RLFE BC BLC BRC".split())


def playback_map(text):
    maps = []
    for match in re.finditer(r"\bchmap-fixed=([^\n]+)", text):
        positions = match[1].strip().split(",")
        if 1 <= len(positions) <= 8 and len(set(positions)) == len(positions) and all(p in POSITIONS for p in positions):
            maps.append(positions)
    return max(maps, key=len, default=[])


def configuration(positions):
    return '''# Generated by steamac audio-layout from the VirtIO ALSA channel map.
monitor.alsa.rules = [
  {
    matches = [ { device.name = "~alsa_card.*" api.alsa.card.name = "VirtIO SoundCard" } ]
    actions = { update-props = {
      api.acp.disable-pro-audio = false
      device.profile = "pro-audio"
    } }
  }
  {
    matches = [ { node.name = "~alsa_output.*" api.alsa.card.name = "VirtIO SoundCard" } ]
    actions = { update-props = {
      audio.channels = %d
      audio.position = [ %s ]
      api.alsa.use-chmap = true
      # VirtIO playback/capture use independent host devices and clocks. Pro Audio's
      # IRQ scheduling and automatic duplex link cause repeated ALSA underruns.
      api.alsa.disable-tsched = false
      api.alsa.auto-link = false
      node.group = "steamac-playback"
    } }
  }
  {
    matches = [ { node.name = "~alsa_input.*" api.alsa.card.name = "VirtIO SoundCard" } ]
    actions = { update-props = {
      api.alsa.disable-tsched = false
      api.alsa.auto-link = false
      node.group = "steamac-capture"
    } }
  }
]
''' % (len(positions), " ".join(positions))


def main():
    directory = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "wireplumber/wireplumber.conf.d"
    target = directory / "99-steamac-audio.conf"
    positions = []
    try:
        for line in Path("/proc/asound/cards").read_text().splitlines():
            card = re.match(r"\s*(\d+)\s+\[.*\].*VirtIO SoundCard", line)
            if card:
                result = subprocess.run(["amixer", "-c", card[1], "cget", "iface=PCM,name='Playback Channel Map'"],
                                        capture_output=True, text=True, timeout=5)
                if result.returncode == 0:
                    positions = playback_map(result.stdout)
                break
        if not positions:
            target.unlink(missing_ok=True)
            return
        text = configuration(positions)
        if target.exists() and target.read_text() == text:
            return
        directory.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix=target.name + ".", dir=directory)
        try:
            with os.fdopen(fd, "w") as output:
                output.write(text)
            os.replace(temporary, target)
        finally:
            Path(temporary).unlink(missing_ok=True)
        print("steamac audio: " + ",".join(positions))
    except (OSError, subprocess.SubprocessError) as error:
        # Audio policy failure must not prevent WirePlumber from starting.
        print("steamac audio layout: " + str(error))


if __name__ == "__main__":
    main()
