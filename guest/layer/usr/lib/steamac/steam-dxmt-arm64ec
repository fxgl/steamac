#!/usr/bin/python3
"""Build a thin native DXMT compatibility tool over an installed ARM64 Proton.

Run before Steam starts. The tool is a directory of symlinks into Proton 11.0 (ARM64) plus
DXMT's own files; the stock Proton is never written, so Vulkan profiles keep native DXVK.

- proton takes its directory from argv[0] without resolving symlinks and copies its DXVK set from
  <directory>/files/lib/wine/dxvk/aarch64-windows into the prefix on every launch: DXMT's
  d3d11/dxgi/d3d10core at that path in this tree reach the prefix, and a game set back to the
  stock tool gets DXVK again at its next launch.
- Wine finds its own files through realpath, so it stays the stock build. winemetal comes from
  WINEDLLPATH (tool/dxmt), which proton appends to its own. Outside prefix creation Wine loads a
  builtin only through a system32 entry, so `run` keeps a winemetal.dll entry in the prefix. Any
  builtin-marked file will do, but Wine looks for the code in the WINEDLLPATH directory of that
  file's architecture: steam-gfx-path's legacy watcher puts its x86-64 winemetal.dll there (in a
  prefix that moved from Proton 10.0, before proton has rewritten its config_info), so the
  ARM64X winemetal.dll is in both tool/dxmt/aarch64-windows and tool/dxmt/x86_64-windows.
- The nested tool/ directory keeps steam-gfx-path's legacy x86-64 installer from taking this for
  a Proton it manages.
"""
import hashlib
import json
import os
from pathlib import Path
import shutil
import struct
import sys
import tempfile

NAME = "steamac_dxmt_arm64ec"
DIRECTORY = "steamac-dxmt-arm64ec"
DXVK = ("d3d11", "dxgi", "d3d10core")
DLLS = DXVK + ("winemetal",)
RECEIPT = ".steamac-arm64ec.json"
# Real directories of the tool (parents first); every other entry is a symlink into the stock tool.
REAL = ("files", "files/lib", "files/lib/wine", "files/lib/wine/dxvk", "files/lib/wine/dxvk/aarch64-windows")
# Not linked: steampipe fixups would run against this tree and write through its links, proton
# truncates dist.lock when it locks it, and user_settings.py would apply to this tool too.
SKIP = {"toolmanifest.vdf", "steampipe_fixups.json", "user_settings.py", "dist.lock", "__pycache__"}
# What this tool relies on in the stock proton script and manifest.
ARGV0_BASE = "Proton(os.path.dirname(sys.argv[0]))"
COMMANDLINE = '"/proton %verb%"'
RUN = """#!/bin/sh
# steamac native DXMT entry point, written by steam-dxmt-arm64ec. No realpath: proton takes its
# directory from the path it is started as.
here=${0%/*}
export WINEDLLPATH="$here/dxmt${WINEDLLPATH:+:$WINEDLLPATH}"
if [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
    s=$STEAM_COMPAT_DATA_PATH/pfx/drive_c/windows/system32
    # a new prefix: proton creates it first, then it gets the winemetal entry
    [ -d "$s" ] || "$here/proton" getcompatpath / >/dev/null 2>&1
    if [ -d "$s" ] && ! cmp -s "$here/dxmt/aarch64-windows/winemetal.dll" "$s/winemetal.dll"; then
        # never write through an old entry: it can link into another tool
        rm -f "$s/winemetal.dll" && cp "$here/dxmt/aarch64-windows/winemetal.dll" "$s/winemetal.dll"
    fi
fi
exec "$here/proton" "$@"
"""


def digest(path):
    with path.open("rb") as src:
        return hashlib.file_digest(src, "sha256").hexdigest()


def payload_files(payload):
    files = [payload / "aarch64-windows" / (dll + ".dll") for dll in DLLS]
    files.append(payload / "aarch64-unix/winemetal.so")
    for path in files:
        if not path.is_file():
            raise ValueError("missing native DXMT payload: " + str(path))
        with path.open("rb") as src:
            header = src.read(64)
            if path.suffix == ".so":
                if len(header) < 20 or header[:6] != b"\x7fELF\x02\x01" or struct.unpack_from("<H", header, 18)[0] != 183:
                    raise ValueError("not an AArch64 ELF unixlib: " + str(path))
            else:
                if len(header) < 64 or header[:2] != b"MZ":
                    raise ValueError("not a PE DLL: " + str(path))
                src.seek(struct.unpack_from("<I", header, 60)[0])
                pe = src.read(6)
                if len(pe) != 6 or pe[:4] != b"PE\0\0" or struct.unpack_from("<H", pe, 4)[0] not in (0xaa64, 0xa641):
                    raise ValueError("not an ARM64X/ARM64EC DLL: " + str(path))
    return files


def in_use(target):
    needle = str(target).encode()
    for process in Path("/proc").glob("[0-9]*"):
        if process.name == str(os.getpid()):
            continue
        try:
            if needle in (process / "maps").read_bytes():
                return True
        except (OSError, PermissionError):
            pass
    return False


def install(source, payload, destination):
    source, payload, destination = source.resolve(), payload.resolve(), destination.absolute()
    required = ("proton", "version", "toolmanifest.vdf", "files/bin-arm64/wine",
                "files/lib/wine/aarch64-unix/ntdll.so",
                "files/lib/wine/dxvk/aarch64-windows/d3d11.dll")
    for relative in required:
        if not (source / relative).is_file():
            raise ValueError("incomplete ARM64 Proton: " + str(source / relative))
    if ARGV0_BASE not in (source / "proton").read_text():
        raise ValueError("this Proton does not take its directory from argv[0]: " + str(source))
    manifest = (source / "toolmanifest.vdf").read_text()
    if COMMANDLINE not in manifest:
        raise ValueError("unexpected toolmanifest.vdf commandline: " + str(source))
    files = payload_files(payload)
    receipt = {"v": 2, "source": str(source),
               "proton": {name: digest(source / name) for name in ("version", "proton", "toolmanifest.vdf")},
               "layout": {rel: sorted(p.name for p in (source / rel).iterdir()) for rel in ("",) + REAL},
               "payload": {str(f.relative_to(payload)): digest(f) for f in files}}
    existing = destination / RECEIPT
    if destination.exists():
        if not existing.is_file():
            raise ValueError("refusing to replace an unmanaged compatibility tool: " + str(destination))
        if json.loads(existing.read_text()) == receipt:
            return False
        if in_use(destination):
            raise ValueError("close games using the native DXMT tool before updating it")
    destination.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=".dxmt-arm64ec-", dir=destination.parent))
    old = None
    try:
        tool = stage / "tool"
        for rel in ("",) + REAL:
            (tool / rel).mkdir()
            for entry in (source / rel).iterdir():
                relative = (Path(rel) / entry.name).as_posix()
                if relative not in REAL and (rel or entry.name not in SKIP):
                    (tool / relative).symlink_to(entry)
        dxvk = tool / "files/lib/wine/dxvk/aarch64-windows"
        for dll in DXVK:
            target = dxvk / (dll + ".dll")
            target.unlink(missing_ok=True)
            data = (payload / "aarch64-windows" / (dll + ".dll")).read_bytes()
            # proton loads its DXVK set native (d3d11=n): drop the "Wine builtin DLL" marker
            target.write_bytes(data[:64] + bytes(16) + data[80:])
        for arch, source_arch, name in (("aarch64-windows", "aarch64-windows", "winemetal.dll"),
                                        ("x86_64-windows", "aarch64-windows", "winemetal.dll"),
                                        ("aarch64-unix", "aarch64-unix", "winemetal.so")):
            (tool / "dxmt" / arch).mkdir(parents=True)
            shutil.copyfile(payload / source_arch / name, tool / "dxmt" / arch / name)
        (tool / "run").write_text(RUN)
        (tool / "run").chmod(0o755)
        (tool / "toolmanifest.vdf").write_text(manifest.replace(COMMANDLINE, '"/run %verb%"'))
        (stage / "compatibilitytool.vdf").write_text(
            '"compatibilitytools" { "compat_tools" { "' + NAME + '" {\n'
            '"install_path" "tool"\n"display_name" "SteamMac DXMT (ARM64EC)"\n'
            '"from_oslist" "windows"\n"to_oslist" "linux"\n} } }\n')
        (stage / RECEIPT).write_text(json.dumps(receipt, sort_keys=True) + "\n")
        if destination.exists():
            old = stage / "previous"
            destination.rename(old)
        try:
            stage.rename(destination)
        except BaseException:
            if old is not None:
                old.rename(destination)
            raise
        if old is not None:
            shutil.rmtree(destination / "previous")
        return True
    finally:
        if stage.exists():
            shutil.rmtree(stage)


def main():
    steam = Path(os.environ.get("STEAMAC_STEAM_ROOT", str(Path.home() / ".local/share/Steam")))
    payload = Path(os.environ.get("STEAMAC_DXMT_DIR", "/usr/lib/steamac/dxmt"))
    if not (payload / "aarch64-unix/winemetal.so").exists():
        return
    source = Path(sys.argv[1]) if len(sys.argv) > 1 else steam / "steamapps/common/Proton 11.0 (ARM64)"
    if not source.exists():
        print("steam-dxmt-arm64ec: install Proton 11.0 (ARM64) first", file=sys.stderr)
        return
    if install(source, payload, steam / "compatibilitytools.d" / DIRECTORY):
        print("steam-dxmt-arm64ec: native compatibility tool ready", file=sys.stderr)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print("steam-dxmt-arm64ec: " + str(error), file=sys.stderr)
        sys.exit(1)
