#!/usr/bin/python3
"""Default Gaming Mode's Steam UI to the virtual display's native resolution.

Steam otherwise requests a 1920x1080 Xwayland surface even when gamescope's
output follows the launcher's Retina display. GameResolutionGlobal controls
games, not this surface, but its Default follows the UI: with the native UI on, a
game left on Default jumps to the native resolution. So the native UI is enabled
only once at least one account has been looked at, and each account's missing/Default
game resolution is first set to the former UI cap. This install-scoped UI setting
lives directly under InstallConfigStore/Gamescope (not Software/Valve/Steam/Gamescope).

What the hook writes, and what it leaves alone:
- A value the user chose (an explicit global resolution, Native, per-game overrides)
  is never touched, and a key Steam removed later is not supplied again.
- The cap it seeds is derived from the display. On every Steam start, while the account
  still holds exactly the value the hook wrote (the marker remembers it), it is
  recomputed for the current display; a value the user changed stays.
- The native UI is enabled once per Steam installation (marker). On a fresh install
  that waits for the first sign-in: the account's config does not exist before, and
  Steam keeps it in memory while it runs, so it can only be edited between Steam runs.
- One account whose config cannot be read or written is skipped and logged.
A new gamescope session is required to lift an existing 1080p cap. An account that
signs in for the first time in a session that already runs the native UI gets its cap at
the next Steam start.
"""
import os
from pathlib import Path
import re
import sys
import tempfile

MARKER = "steamac-native-resolution"
GAME_KEY = ("UserLocalConfigStore", "Gamescope", "GameResolutionGlobal")
KEY = ("InstallConfigStore", "Gamescope", "EnableSteamNativeExternalResolution")
EMPTY = '"InstallConfigStore"\n{\n}\n'
VDF_TOKEN = re.compile(r'//[^\r\n]*|"(?:\\.|[^"\\])*"|[{}"]|[^\s{}"]+')
SIZE = r"[0-9]+x[0-9]+"


def read_config(path):
    with path.open(encoding="utf-8", newline="") as source:
        return source.read()


def atomic_write(path, text):
    """Replace one file durably, retaining its existing permissions."""
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as out:
            out.write(text)
            out.flush()
            os.fchmod(out.fileno(), mode)
            os.fsync(out.fileno())
        os.replace(tmp, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        Path(tmp).unlink(missing_ok=True)


def unquote(token):
    if not token.startswith('"'):
        return token
    token = token[1:-1]
    if "\\" not in token:
        return token
    return re.sub(r'\\([\\"nrt])',
                  lambda m: {"n": "\n", "r": "\r", "t": "\t"}.get(m[1], m[1]), token)


def resolution_entry(text, path, config=None):
    """Find one setting and its deepest existing container, without rebuilding VDF."""
    # Valve's KeyValues reader appends same-named siblings; FindKey uses the first.
    # Follow that branch only, and leave every duplicate byte untouched.
    names = tuple(part.lower() for part in path)
    tokens = (m for m in VDF_TOKEN.finditer(text, int(text.startswith("\ufeff")))
              if not m[0].startswith("//"))
    frames = [(True, set())]
    entry = parent = None
    duplicate = False
    for token in tokens:
        if token[0] == "}":
            if len(frames) == 1:
                raise ValueError("unbalanced VDF closing brace")
            matched, _ = frames.pop()
            if matched and parent is None:
                parent = len(frames), token.start()
            continue
        value = next(tokens, None)
        if token[0] in ('{', '"') or value is None or value[0] in ('}', '"'):
            raise ValueError("incomplete VDF key/value")
        key = unquote(token[0]).lower()
        matched, seen = frames[-1]
        if key in seen:
            duplicate = True
            matched = False
        else:
            seen.add(key)
            matched = matched and names[len(frames) - 1] == key
        is_block = value[0] == "{"
        if matched and is_block == (len(frames) == len(names)):
            raise ValueError(f"unexpected VDF type at {'/'.join(path[:len(frames)])}")
        if is_block:
            frames.append((matched, set()))
        elif matched:
            entry = unquote(value[0]), value.start(), value.end()
    if len(frames) != 1:
        raise ValueError("unbalanced VDF opening brace")
    if duplicate and config is not None:
        print(f"steam-native-resolution: duplicate VDF keys in {config}; using first occurrences",
              file=sys.stderr)
    return entry, parent


def set_resolution(text, path, entry, parent, value):
    if entry:
        _, start, end = entry
        return text[:start] + f'"{value}"' + text[end:]
    if parent is None:
        raise ValueError(f"no {path[0]} block")
    depth, end = parent
    line = text.rfind("\n", 0, end)
    newline = "\r\n" if line > 0 and text[line - 1] == "\r" else "\n"
    start = line + 1
    indent = "\t" * (len(path) - 1)
    addition = f'{indent}"{path[-1]}"\t\t"{value}"{newline}'
    for level in range(len(path) - 2, depth - 1, -1):
        indent = "\t" * level
        addition = f'{indent}"{path[level]}"{newline}{indent}{{{newline}{addition}{indent}}}{newline}'
    if text[start:end].strip():
        start = end
        addition = newline + addition
    return text[:start] + addition + text[start:]


def native_resolution(text, config=None):
    entry, parent = resolution_entry(text, KEY, config)
    return text if entry else set_resolution(text, KEY, entry, parent, "1")


def legacy_resolution(width, height):
    """Match Steam's former external-UI cap; never enlarge a small display."""
    cap_height = 1200 if width * 10 == height * 16 else 1080
    return (1920, cap_height) if width * height > 1920 * 1200 else (width, height)


def preferred_mode():
    for modes in sorted(Path("/sys/class/drm").glob("card*-*/modes")):
        lines = modes.read_text().splitlines()
        if lines and (match := re.fullmatch(r"([0-9]+)x([0-9]+)", lines[0])):
            width, height = map(int, match.groups())
            if width > 0 and height > 0:
                return width, height
    raise ValueError("no preferred DRM display mode; retry next Steam start")


def format_size(size):
    return f"{size[0]}x{size[1]}"


def read_marker(marker):
    """Return the previous seed and, for an interrupted write, the intended seed."""
    try:
        content = marker.read_text().strip()
    except FileNotFoundError:
        return None, None
    if found := re.fullmatch(rf"pending (default|{SIZE}) ({SIZE})", content):
        before, after = found.groups()
        return (None if before == "default" else before), after
    found = re.fullmatch(rf"seeded ({SIZE})", content)
    return (found[1] if found else ""), None


def protect_account(config):
    """Protect one account before it can count towards enabling the native UI."""
    marker = config.parent / MARKER
    seeded, pending = read_marker(marker)
    if seeded == "":
        return True
    text = read_config(config)
    entry, parent = resolution_entry(text, GAME_KEY, config)
    current = entry[0].lower() if entry else None
    if pending is not None and current == pending:
        # The config was replaced, but the new seed wasn't finalized.
        seeded = pending
    managed = current in (None, "", "default") if seeded is None else current == seeded
    if not managed:
        atomic_write(marker, "kept\n")
        return True

    value = format_size(legacy_resolution(*preferred_mode()))
    if value != seeded:
        changed = set_resolution(text, GAME_KEY, entry, parent, value)
        # Record both possible config states before replacing the VDF.
        atomic_write(marker, f"pending {seeded or 'default'} {value}\n")
        atomic_write(config, changed)
        previous = f"{seeded} -> " if seeded else ""
        print(f"steam-native-resolution: game resolution {previous}{value} in {config}", file=sys.stderr)
    if value != seeded or pending is not None:
        atomic_write(marker, f"seeded {value}\n")
    return True


def preserve_game_defaults(steamroot):
    """Protect every account whose config exists; return how many are handled."""
    handled = 0
    for config in sorted((steamroot / "userdata").glob("*/config/localconfig.vdf")):
        if not config.parent.parent.name.isdecimal():
            continue
        try:
            handled += protect_account(config)
        except (OSError, ValueError) as error:
            print(f"steam-native-resolution: skipping {config}: {error}", file=sys.stderr)
    return handled


def main():
    steamroot = Path.home() / ".local/share/Steam"
    # Account configs first, on every start: accounts can be added after the install marker.
    handled = preserve_game_defaults(steamroot)
    config = steamroot / "config/config.vdf"
    marker = config.parent / MARKER
    if marker.exists():
        return
    text = read_config(config) if config.exists() else ""
    changed = native_resolution(text if text.strip() else EMPTY, config)
    if changed != text and not handled:
        print("steam-native-resolution: native UI waits for the first account's game resolution; "
              "retry next Steam start", file=sys.stderr)
        return
    if changed != text:
        atomic_write(config, changed)
        print("steam-native-resolution: default Steam UI to native display resolution", file=sys.stderr)
    atomic_write(marker, "1\n")


if __name__ == "__main__":
    # Never block Steam's start: whatever fails here is logged.
    try:
        main()
    except Exception as error:
        print("steam-native-resolution: leaving remaining settings unchanged: " + str(error), file=sys.stderr)
