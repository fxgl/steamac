+// Width adaptation is opt-in and exact: never use the vertex-fetch location/component fallback,
+// change a logical type, or touch the tessellation/geometry buffer ABI.
+uint32_t CompilerMSL::ensure_stage_interface_type(StorageClass storage, uint32_t type_id,
+                                                 uint32_t location, uint32_t component)
+{
+	if (!msl_options.pad_stage_interface_components)
+		return type_id;
+	bool output = storage == StorageClassOutput && get_execution_model() == ExecutionModelVertex &&
+	              !capture_output_to_buffer && !msl_options.for_mesh_pipeline;
+	bool input = storage == StorageClassInput && get_execution_model() == ExecutionModelFragment;
+	if (!output && !input)
+		return type_id;
+	auto &type = get<SPIRType>(type_id);
+	if (type.basetype == SPIRType::Struct || type.pointer || !type.array.empty() || type.columns != 1 ||
+	    (type.width != 16 && type.width != 32))
+		return type_id;
+	auto &variables = output ? outputs_by_location : inputs_by_location;
+	auto itr = variables.find({location, component});
+	if (itr == variables.end())
+		return type_id;
+	uint32_t width = itr->second.vecsize;
+	if (width <= type.vecsize || width > 4 || component + width > 4)
+		return type_id;
+	return build_extended_vector_type(type_id, width);
+}
+
+std::string CompilerMSL::to_stage_output_value(uint32_t physical_type_id, const SPIRType &logical_type,
+                                              const std::string &value)
+{
+	auto &physical_type = get<SPIRType>(physical_type_id);
+	if (!msl_options.pad_stage_interface_components || physical_type.vecsize <= logical_type.vecsize)
+		return value;
+	string widened = join(type_to_glsl(physical_type), "(", value);
+	for (uint32_t i = logical_type.vecsize; i < physical_type.vecsize; i++)
+		widened += ", 0";
+	return widened + ")";
+}
+
 // Ensure that the type is compatible with the shader input.
 // If it is, simply return the given type ID.
 // Otherwise, create a new type, and return its ID.
