-	    (is_sample_rate() && (active_input_builtins.get(BuiltInFragCoord) ||
+	    (is_sample_rate() && (msl_options.sample_rate_interpolation_as_offset || active_input_builtins.get(BuiltInFragCoord) ||
 	                          (need_subpass_input_ms && !msl_options.use_framebuffer_fetch_subpasses))))
 		needs_sample_id = true;
 	if (preproc.needs_helper_invocation || active_input_builtins.get(BuiltInHelperInvocation))
@@ -4219,6 +4219,25 @@
 	if (is_noperspective)
 		set_decoration(new_type_id, DecorationNoPerspective);
 	return new_type_id;
+}
+
+bool CompilerMSL::uses_pull_model_interpolation(uint32_t id, bool is_sample, bool is_flat) const
+{
+	return pull_model_inputs.count(id) ||
+	       (msl_options.sample_rate_interpolation_as_offset && is_sample && !is_flat);
+}
+
+string CompilerMSL::default_interpolation_method(bool is_centroid, bool is_sample)
+{
+	if (is_centroid)
+		return ".interpolate_at_centroid()";
+	if (is_sample)
+	{
+		if (msl_options.sample_rate_interpolation_as_offset)
+			return join(".interpolate_at_offset(get_sample_position(", to_expression(builtin_sample_id_id), "))");
+		return join(".interpolate_at_sample(", to_expression(builtin_sample_id_id), ")");
+	}
+	return ".interpolate_at_center()";
 }
 
