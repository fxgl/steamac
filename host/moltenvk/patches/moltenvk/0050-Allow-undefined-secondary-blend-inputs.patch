@@ -2331,6 +2331,7 @@
 		if ( !mtlFunc ) { return false; }
 
 		auto& funcRslts = func.shaderConversionResults;
+		_fragmentOutputSecondaryMask = funcRslts.fragmentOutputSecondaryMask;
 		populateResourceUsage(_stageResources[kMVKShaderStageFragment], shaderConfig, funcRslts, spv::ExecutionModelFragment);
 		_layout->populateBindOperations(_stageResources[kMVKShaderStageFragment].bindScript, shaderConfig, spv::ExecutionModelFragment);
 	}
@@ -2635,6 +2636,25 @@
 	plDesc.tessellationPartitionMode = mvkMTLTessellationPartitionModeFromSpvExecutionMode(reflectData.partitionMode);
 }
 
+// Vulkan permits an absent secondary blend output (framebuffer-dsb): its value is
+// undefined. Choose zero in that case instead of asking Metal to link a nonexistent
+// color(N), index(1). Never replace factors when SPIR-V actually declares Index=1.
+static MTLBlendFactor blendFactorWithSecondaryOutput(VkBlendFactor factor, bool hasSecondary) {
+	if (!hasSecondary) {
+		switch (factor) {
+			case VK_BLEND_FACTOR_SRC1_COLOR:
+			case VK_BLEND_FACTOR_SRC1_ALPHA:
+				return MTLBlendFactorZero;
+			case VK_BLEND_FACTOR_ONE_MINUS_SRC1_COLOR:
+			case VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA:
+				return MTLBlendFactorOne;
+			default:
+				break;
+		}
+	}
+	return mvkMTLBlendFactorFromVkBlendFactor(factor);
+}
+
