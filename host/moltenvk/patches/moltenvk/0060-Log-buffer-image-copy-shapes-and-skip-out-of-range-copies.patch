+
+// STEAMAC-5/D3/D4: the VM process crashed (SIGBUS/SIGSEGV) inside AGX while encoding
+// copyFromTexture:...toBuffer: of a vkCmdCopyImageToBuffer, with nothing in the logs saying what
+// was copied. Every distinct copy shape is logged once (bounded), at any log level, so the copy a
+// crash follows can be matched; a copy whose level, slice, size or buffer span is out of range of
+// its Metal objects is logged and not encoded instead of reaching the driver.
+struct MVKBufferImageCopyShape {
+	bool toImage;
+	id<MTLTexture> texture;
+	MTLPixelFormat format;
+	VkFormat vkFormat;
+	uint32_t level;
+	uint32_t slice;
+	MTLOrigin origin;
+	MTLSize size;
+	id<MTLBuffer> buffer;
+	uint64_t offset;
+	uint64_t bytesPerRow;
+	uint64_t bytesPerImage;
+	uint64_t end;
+	MTLBlitOption options;
+};
+
+static void mvkLogBufferImageCopy(const char* what, const MVKBufferImageCopyShape& c, MVKPixelFormats* pixFmts) {
+	id<MTLTexture> t = c.texture;
+	fprintf(stderr, "[mvk-copy] %s %s: texture %s (Vk %s) type %lu %lux%lux%lu levels %lu layers %lu storage %lu%s%s,"
+			" level %u slice %u origin %lu,%lu,%lu size %lux%lux%lu; buffer length %lu storage %lu%s%s offset %llu"
+			" bytes/row %llu bytes/image %llu end %llu options %lu\n",
+			what, c.toImage ? "vkCmdCopyBufferToImage" : "vkCmdCopyImageToBuffer",
+			pixFmts->getName(c.format), pixFmts->getName(c.vkFormat), (unsigned long)t.textureType,
+			(unsigned long)t.width, (unsigned long)t.height, (unsigned long)t.depth,
+			(unsigned long)t.mipmapLevelCount, (unsigned long)t.arrayLength, (unsigned long)t.storageMode,
+			t.buffer ? " buffer-backed" : "", t.heap ? " heap" : "",
+			c.level, c.slice, (unsigned long)c.origin.x, (unsigned long)c.origin.y, (unsigned long)c.origin.z,
+			(unsigned long)c.size.width, (unsigned long)c.size.height, (unsigned long)c.size.depth,
+			(unsigned long)c.buffer.length, (unsigned long)c.buffer.storageMode, c.buffer.heap ? " heap" : "",
+			c.buffer.contents ? " mapped" : "", (unsigned long long)c.offset, (unsigned long long)c.bytesPerRow,
+			(unsigned long long)c.bytesPerImage, (unsigned long long)c.end, (unsigned long)c.options);
+}
+
+// Logs a shape the first time it is seen, up to 128 per process (origin and offset excluded).
+static void mvkNoteBufferImageCopyShape(const MVKBufferImageCopyShape& c, MVKPixelFormats* pixFmts) {
+	constexpr uint32_t maxShapes = 128;
+	static std::mutex lock;
+	static uint64_t seen[maxShapes];
+	static uint32_t count;
+	id<MTLTexture> t = c.texture;
+	const uint64_t fields[] = {
+		c.toImage, (uint64_t)c.format, (uint64_t)t.textureType, t.width, t.height, t.depth, t.mipmapLevelCount,
+		t.arrayLength, (uint64_t)t.storageMode, t.buffer != nil, c.level, c.size.width, c.size.height,
+		c.size.depth, c.bytesPerRow, c.bytesPerImage, (uint64_t)c.options, (uint64_t)c.buffer.storageMode,
+		c.buffer.heap != nil,
+	};
+	uint64_t hash = 1469598103934665603ull;
+	for (uint64_t f : fields) { hash = (hash ^ f) * 1099511628211ull; }
+	{
+		std::lock_guard<std::mutex> guard(lock);
+		if (count > maxShapes) { return; }
+		for (uint32_t i = 0; i < count; i++) { if (seen[i] == hash) { return; } }
+		if (count == maxShapes) {
+			count++;
+			fprintf(stderr, "[mvk-copy] %u buffer/image copy shapes logged; further ones are not\n", count - 1);
+			return;
+		}
+		seen[count++] = hash;
+	}
+	mvkLogBufferImageCopy("shape", c, pixFmts);
+}
+
+// Why the copy is out of range of its Metal texture or buffer, or NULL.
+static const char* mvkBufferImageCopyRangeError(const MVKBufferImageCopyShape& c) {
+	id<MTLTexture> t = c.texture;
+	NSUInteger slices = 1;
+	switch (t.textureType) {
+		case MTLTextureType1DArray:
+		case MTLTextureType2DArray:
+		case MTLTextureType2DMultisampleArray: slices = t.arrayLength; break;
+		case MTLTextureTypeCube: slices = 6; break;
+		case MTLTextureTypeCubeArray: slices = 6 * t.arrayLength; break;
+		default: break;
+	}
+	if (c.level >= t.mipmapLevelCount) { return "level past the texture's mip levels"; }
+	if (c.slice >= slices) { return "slice past the texture's slices"; }
+	if (!c.size.width || !c.size.height || !c.size.depth) { return "empty size (origin outside the level)"; }
+	if (c.end > c.buffer.length) { return "buffer span past the Metal buffer"; }
+	return nullptr;
+}
