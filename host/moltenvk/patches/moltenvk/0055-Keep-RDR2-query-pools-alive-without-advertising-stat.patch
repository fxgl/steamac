 NSData* MVKTimestampQueryPool::getQuerySourceData(uint32_t firstQuery, uint32_t queryCount) {
-	if (_mtlCounterBuffer) {
-		return [_mtlCounterBuffer resolveCounterRange: NSMakeRange(firstQuery, queryCount)];
+	if (hasMTLCounterBuffer()) {
+		uint32_t index = getMTLCounterIndex(firstQuery);
+		if (queryCount <= kCounterBufferQueryCount - index) {
+			return [getMTLCounterBuffer(firstQuery) resolveCounterRange: NSMakeRange(index, queryCount)];
+		}
+		NSMutableData* results = [NSMutableData dataWithCapacity: queryCount * kMVKQuerySlotSizeInBytes];
+		while (queryCount) {
+			index = getMTLCounterIndex(firstQuery);
+			uint32_t count = min(queryCount, kCounterBufferQueryCount - index);
+			[results appendData: [getMTLCounterBuffer(firstQuery) resolveCounterRange: NSMakeRange(index, count)]];
+			firstQuery += count;
+			queryCount -= count;
+		}
+		return results;
 	} else {
 		return [NSData dataWithBytesNoCopy: (void*)&_timestamps[firstQuery]
 									length: queryCount * kMVKQuerySlotSizeInBytes
@@ -430,17 +453,30 @@
 													MVKBuffer* destBuffer,
 													VkDeviceSize destOffset,
 													VkDeviceSize stride) {
-	if (_mtlCounterBuffer) {
-		id<MTLBlitCommandEncoder> mtlBlitCmdEnc = cmdEncoder->getMTLBlitEncoder(kMVKCommandUseCopyQueryPoolResults);
-		[mtlBlitCmdEnc resolveCounters: _mtlCounterBuffer
-							   inRange: NSMakeRange(firstQuery,  queryCount)
-					 destinationBuffer: destBuffer->getMTLBuffer()
-					 destinationOffset: destBuffer->getMTLBufferOffset() + destOffset];
+	if (hasMTLCounterBuffer()) {
+		encodeCounterResolve(cmdEncoder, firstQuery, queryCount, destBuffer->getMTLBuffer(),
+							 destBuffer->getMTLBufferOffset() + destOffset);
 	} else {
 		MVKQueryPool::encodeDirectCopyResults(cmdEncoder, firstQuery, queryCount, destBuffer, destOffset, stride);
 	}
 }
 
+void MVKTimestampQueryPool::encodeCounterResolve(MVKCommandEncoder* cmdEncoder, uint32_t firstQuery, uint32_t queryCount,
+												id<MTLBuffer> destBuffer, NSUInteger destOffset) {
+	id<MTLBlitCommandEncoder> enc = cmdEncoder->getMTLBlitEncoder(kMVKCommandUseCopyQueryPoolResults);
+	while (queryCount) {
+		uint32_t index = getMTLCounterIndex(firstQuery);
+		uint32_t count = min(queryCount, kCounterBufferQueryCount - index);
+		[enc resolveCounters: getMTLCounterBuffer(firstQuery)
+					 inRange: NSMakeRange(index, count)
+		   destinationBuffer: destBuffer
+		   destinationOffset: destOffset];
+		firstQuery += count;
+		queryCount -= count;
+		destOffset += count * kMVKQuerySlotSizeInBytes;
+	}
+}
+
 id<MTLBuffer> MVKTimestampQueryPool::getResultBuffer(MVKCommandEncoder* cmdEncoder, uint32_t firstQuery, uint32_t queryCount, NSUInteger& offset) {
 	const MVKMTLBufferAllocation* tempBuff = cmdEncoder->getTempMTLBuffer(queryCount * _queryElementCount * sizeof(uint64_t));
 	void* pBuffData = tempBuff->getContents();
@@ -451,15 +487,10 @@
 }
 
 id<MTLComputeCommandEncoder> MVKTimestampQueryPool::encodeComputeCopyResults(MVKCommandEncoder* cmdEncoder, uint32_t firstQuery, uint32_t queryCount, uint32_t index) {
-	if (_mtlCounterBuffer) {
-		// We first need to resolve from the MTLCounterSampleBuffer into a temp buffer using a
-		// MTLBlitCommandEncoder, before creating the compute encoder and set that temp buffer into it.
+	if (hasMTLCounterBuffer()) {
+		// Resolve all affected sample buffers before switching to the compute encoder.
 		const MVKMTLBufferAllocation* tempBuff = cmdEncoder->getTempMTLBuffer(queryCount * _queryElementCount * sizeof(uint64_t));
-		id<MTLBlitCommandEncoder> mtlBlitCmdEnc = cmdEncoder->getMTLBlitEncoder(kMVKCommandUseCopyQueryPoolResults);
-		[mtlBlitCmdEnc resolveCounters: _mtlCounterBuffer
-							   inRange: NSMakeRange(firstQuery,  queryCount)
-					 destinationBuffer: tempBuff->_mtlBuffer
-					 destinationOffset: tempBuff->_offset];
+		encodeCounterResolve(cmdEncoder, firstQuery, queryCount, tempBuff->_mtlBuffer, tempBuff->_offset);
 
 		id<MTLComputeCommandEncoder> mtlCmdEnc = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseCopyQueryPoolResults);
 		cmdEncoder->getMtlCompute().bindBuffer(mtlCmdEnc, tempBuff->_mtlBuffer, tempBuff->_offset, index);
@@ -481,7 +512,7 @@
 		initMTLCounterSampleBuffer(pCreateInfo, _device->getTimestampMTLCounterSet(), "VK_QUERY_TYPE_TIMESTAMP");
 
 		// If we don't use a MTLCounterSampleBuffer, allocate memory to hold the timestamps.
-		if ( !_mtlCounterBuffer ) { _timestamps.resize(pCreateInfo->queryCount, 0); }
+		if (!hasMTLCounterBuffer()) { _timestamps.resize(pCreateInfo->queryCount, 0); }
 }
 
 
@@ -489,10 +520,41 @@
 #pragma mark MVKPipelineStatisticsQueryPool
 
 MVKPipelineStatisticsQueryPool::MVKPipelineStatisticsQueryPool(MVKDevice* device,
-															   const VkQueryPoolCreateInfo* pCreateInfo) : MVKGPUCounterQueryPool(device, pCreateInfo) {
-	if ( !getEnabledFeatures().pipelineStatisticsQuery ) {
-		setConfigurationResult(reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkCreateQueryPool: VK_QUERY_TYPE_PIPELINE_STATISTICS is not supported."));
-	}
+															 const VkQueryPoolCreateInfo* pCreateInfo) :
+	MVKQueryPool(device, pCreateInfo, __builtin_popcount(pCreateInfo->pipelineStatistics)),
+	_zeroResults(size_t(pCreateInfo->queryCount) * _queryElementCount, 0) {
+	// VUID-00791 forbids this call without pipelineStatisticsQuery, which remains
+	// false. RDR2 makes it anyway. Venus creates pools asynchronously, so refusing
+	// it kills the context at its first use. Return deterministic zeros, not an
+	// advertised feature or uninitialized results, for this invalid application use.
+	reportWarning(VK_SUCCESS, "Pipeline statistics are unsupported; returning zero counters for a pool created without pipelineStatisticsQuery.");
+}
+
+void MVKPipelineStatisticsQueryPool::endQuery(uint32_t query, MVKCommandEncoder* cmdEncoder) {
+	uint32_t count = cmdEncoder->isInRenderPass() ? cmdEncoder->getSubpass()->getViewCountInMetalPass(cmdEncoder->getMultiviewPassIndex()) : 1;
+	cmdEncoder->addActivatedQueries(this, query, max(count, 1u));
+	MVKQueryPool::endQuery(query, cmdEncoder);
+}
+
+NSData* MVKPipelineStatisticsQueryPool::getQuerySourceData(uint32_t firstQuery, uint32_t queryCount) {
+	return [NSData dataWithBytesNoCopy: _zeroResults.data() + size_t(firstQuery) * _queryElementCount
+							   length: size_t(queryCount) * _queryElementCount * sizeof(uint64_t)
+						 freeWhenDone: false];
+}
+
+id<MTLBuffer> MVKPipelineStatisticsQueryPool::getResultBuffer(MVKCommandEncoder* cmdEncoder, uint32_t firstQuery, uint32_t queryCount, NSUInteger& offset) {
+	const auto* allocation = cmdEncoder->copyToTempMTLBufferAllocation(_zeroResults.data() + size_t(firstQuery) * _queryElementCount,
+																	 size_t(queryCount) * _queryElementCount * sizeof(uint64_t));
+	offset = allocation->_offset;
+	return allocation->_mtlBuffer;
+}
+
+id<MTLComputeCommandEncoder> MVKPipelineStatisticsQueryPool::encodeComputeCopyResults(MVKCommandEncoder* cmdEncoder,
+																					uint32_t firstQuery, uint32_t queryCount, uint32_t index) {
+	auto enc = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseCopyQueryPoolResults);
+	cmdEncoder->setComputeBytes(enc, _zeroResults.data() + size_t(firstQuery) * _queryElementCount,
+							   size_t(queryCount) * _queryElementCount * sizeof(uint64_t), index);
+	return enc;
 }
 
 
