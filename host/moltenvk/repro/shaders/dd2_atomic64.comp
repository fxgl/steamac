#version 460
// 64-bit atomic min/max on a storage buffer, Device scope, Relaxed semantics — the shape
// vkd3d-proton emits for a D3D12 title that does atomic_fetch_max on an atomic_ulong
// (Dragon's Dogma 2). The MSL that KosmicKrisp generates for this does not compile today:
//
//	t925 = atomic_fetch_max_explicit((device atomic_ulong*)t922, t867, memory_order_relaxed);
//	  error: no matching function for call to 'atomic_fetch_max_explicit'
//
// atomic64.c recomputes every expectation on the CPU from the same mix() and checks the buffer.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer Counters {
	uint64_t umax;
	uint64_t umin;
	uint64_t fetch_umax;
	uint64_t fetch_umin;
	uint umax32;
	uint pad;
};

// per-invocation results of the fetch forms (checked against the set of values written)
layout(set = 0, binding = 1, std430) buffer Sink {
	uint64_t v[];
} sink;

uint64_t mix(uint64_t x)
{
	x ^= x >> 33;
	x *= 0xff51afd7ed558ccdUL;
	x ^= x >> 29;
	return x;
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint64_t id = uint64_t(i);
	uint64_t a = mix(id);
	uint a32 = uint(a);

	atomicMax(umax, a);
	atomicMin(umin, a);
	atomicMax(umax32, a32); // 32-bit control: this one compiles on both drivers today

	// The fetch forms: at most one invocation sees the initial value, so under contention the
	// returned value cannot be predicted — but it must be a value some invocation wrote (or the
	// initial value), which catches truncation, a constant, or an uninitialized temp.
	uint64_t o1 = atomicMax(fetch_umax, a);
	uint64_t o2 = atomicMin(fetch_umin, ~a);
	sink.v[i * 2u + 0u] = o1;
	sink.v[i * 2u + 1u] = o2;
}
