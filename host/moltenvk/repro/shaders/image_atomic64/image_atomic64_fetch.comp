#version 460
// One invocation, so there is no contention: the value imageAtomicMax/imageAtomicMin returns is
// exactly the texel's original value, which is what Vulkan requires. image_atomic64.c presets the
// cell twice, once where the atomic changes it and once where it does not, and checks both the
// returned value and the texel that was actually written.
#extension GL_EXT_shader_image_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1) in;

layout(r64ui, binding = 0) uniform u64image2D img_max;
layout(r64ui, binding = 1) uniform u64image2D img_min;

layout(set = 0, binding = 2, std430) buffer Cells {
	uint64_t old_max;
	uint64_t old_min;
};

void main()
{
	old_max = imageAtomicMax(img_max, ivec2(0), 0xfeedfacecafebeefUL);
	old_min = imageAtomicMin(img_min, ivec2(0), 0x123456789abcdef0UL);
}
