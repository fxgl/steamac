    {"compiles", KK_DEBUG_COMPILES},
+   {"novertexsubgroups", KK_DEBUG_NO_VERTEX_SUBGROUPS},
    {NULL, 0},
 };
 
diff --git a/src/kosmickrisp/vulkan/kk_debug.h b/src/kosmickrisp/vulkan/kk_debug.h
index a9c5c8c..acc6042 100644
--- a/src/kosmickrisp/vulkan/kk_debug.h
+++ b/src/kosmickrisp/vulkan/kk_debug.h
@@ -24,6 +24,9 @@ enum kk_debug {
    /* Log every Metal compile (library, compute or render pipeline) with its
     * MSL hashes, thread, MTL4Compiler and the compiles in flight with it */
    KK_DEBUG_COMPILES = 1ull << 6,
+   /* Do not advertise subgroups in the vertex stage (the lane id is recovered
+    * there in msl_emit_vertex_subgroup_helpers): A/B for the recovery */
+   KK_DEBUG_NO_VERTEX_SUBGROUPS = 1ull << 8,
 };
 
 extern enum kk_debug kk_mesa_debug_flags;
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 9e99176..50d12c4 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -77,8 +77,6 @@ kk_get_device_extensions(const struct kk_instance *instance,
       .KHR_imageless_framebuffer = true,
       .KHR_sampler_mirror_clamp_to_edge = true,
       .KHR_separate_depth_stencil_layouts = true,
-      .KHR_shader_atomic_int64 = false,
-      .KHR_shader_float_controls = true,
       .KHR_shader_float16_int8 = true,
       .KHR_shader_subgroup_extended_types = true,
       .KHR_spirv_1_4 = true,
@@ -692,8 +690,13 @@ kk_get_device_properties(
 
       /* Vulkan 1.1 properties */
       .subgroupSize = 32,
+      /* Metal rejects the SIMD-group *attributes* ([[thread_index_in_simdgroup]]
+       * and friends) in a vertex function, but allows every SIMD-group
+       * *function* there, so nir_to_msl.c recovers the lane id from a ballot
+       * and a scan instead of declaring it. */
       .subgroupSupportedStages =
-         VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT,
+         VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT |
+         (KK_DEBUG(NO_VERTEX_SUBGROUPS) ? 0 : VK_SHADER_STAGE_VERTEX_BIT),
       .subgroupSupportedOperations =
          VK_SUBGROUP_FEATURE_BASIC_BIT | VK_SUBGROUP_FEATURE_VOTE_BIT |
          VK_SUBGROUP_FEATURE_ARITHMETIC_BIT | VK_SUBGROUP_FEATURE_BALLOT_BIT |
