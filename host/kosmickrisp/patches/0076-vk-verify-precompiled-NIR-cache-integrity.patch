 {
+   const char *reason = "missing or incompatible integrity header";
+   if (blob_read_uint32(blob) != VK_PIPELINE_PRECOMP_SHADER_CACHE_VERSION)
+      goto reject;
+
    const mesa_shader_stage stage = blob_read_uint32(blob);
 
    struct vk_pipeline_robustness_state rs;
@@ -779,12 +791,25 @@ vk_pipeline_precomp_shader_deserialize(struct vk_device *device,
       blob_read_bytes(blob, embedded_sampler_count * sizeof(*embedded_samplers));
 
    uint64_t nir_size = blob_read_uint64(blob);
+   blake3_hash expected_hash;
+   blob_copy_bytes(blob, expected_hash, sizeof(expected_hash));
+   reason = "truncated precompiled NIR";
    if (blob->overrun || nir_size > SIZE_MAX)
-      return NULL;
+      goto reject;
 
    const void *nir_data = blob_read_bytes(blob, nir_size);
    if (blob->overrun)
-      return NULL;
+      goto reject;
