+   _mesa_blake3_compute(nir_data, nir_size, nir_hash);
+   reason = "precompiled NIR BLAKE3 mismatch";
+   if (memcmp(nir_hash, expected_hash, sizeof(nir_hash)) != 0)
+      goto reject;
+
+   reason = "invalid precompiled NIR stage";
+   if (stage >= MESA_SHADER_STAGES)
+      goto reject;
 
    VK_MULTIALLOC(ma);
    VK_MULTIALLOC_DECL(&ma, struct vk_pipeline_precomp_shader, shader, 1);
@@ -813,6 +838,7 @@ vk_pipeline_precomp_shader_deserialize(struct vk_device *device,
 
    blob_init(&shader->nir_blob);
    blob_write_bytes(&shader->nir_blob, nir_data, nir_size);
+   memcpy(shader->nir_hash, nir_hash, sizeof(shader->nir_hash));
    if (shader->nir_blob.out_of_memory)
       goto fail_cache_obj;
 
@@ -823,6 +849,18 @@ fail_cache_obj:
    vk_free(&device->alloc, shader);
 
    return NULL;
+
+reject: {
+   blake3_hash key_hash;
+   char hex[BLAKE3_HEX_LEN];
+   _mesa_blake3_compute(key_data, key_size, key_hash);
+   _mesa_blake3_format(hex, key_hash);
+   const char *app = device->physical->instance->app_info.app_name;
+   mesa_loge("vk: rejecting cached precompiled NIR app=%s entry=%s: %s; "
+             "cache miss, recompiling SPIR-V",
