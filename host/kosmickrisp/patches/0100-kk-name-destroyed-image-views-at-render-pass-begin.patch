+   simple_mtx_t live_image_views_lock;
+   struct set *live_image_views;
 
    struct kk_precompiled_cache precompiled_cache;
 
diff --git a/src/kosmickrisp/vulkan/kk_image_view.c b/src/kosmickrisp/vulkan/kk_image_view.c
index 3f18c03..0e7bb5a 100644
--- a/src/kosmickrisp/vulkan/kk_image_view.c
