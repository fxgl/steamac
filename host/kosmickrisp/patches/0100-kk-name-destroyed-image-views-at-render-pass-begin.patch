+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -31,6 +31,7 @@
 #include "vk_pipeline_cache.h"
 
 #include "util/os_time.h"
+#include "util/set.h"
 
 #include <stdio.h>
 #include <time.h>
@@ -391,6 +392,12 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
    dev->vk.command_buffer_ops = &kk_cmd_buffer_ops;
    dev->vk.command_dispatch_table = &dev->vk.dispatch_table;
    dev->vk.get_timestamp = kk_get_timestamp;
+   simple_mtx_init(&dev->live_image_views_lock, mtx_plain);
+   dev->live_image_views = _mesa_pointer_set_create(NULL);
+   if (dev->live_image_views == NULL) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail_device;
+   }
    /* Compiled MSL libraries and Metal pipeline states are shared between equal
     * pipelines and the pool compiles into them: both are set up before any
     * pipeline is created. */
@@ -485,6 +492,8 @@ fail_init:
    kk_compile_pool_finish(dev);
    kk_metal_caches_finish(dev);
 fail_device:
+   _mesa_set_destroy(dev->live_image_views, NULL);
+   simple_mtx_destroy(&dev->live_image_views_lock);
    vk_device_finish(&dev->vk);
 fail_alloc:
    vk_free(&dev->vk.alloc, dev);
@@ -540,6 +549,10 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
 
    kk_release_compiler(dev);
 
+   /* After meta, the last creator of image views */
+   _mesa_set_destroy(dev->live_image_views, NULL);
+   simple_mtx_destroy(&dev->live_image_views_lock);
+
    vk_device_finish(&dev->vk);
 
    vk_free(&dev->vk.alloc, dev);
diff --git a/src/kosmickrisp/vulkan/kk_device.h b/src/kosmickrisp/vulkan/kk_device.h
index 0eba6fc..64f2813 100644
--- a/src/kosmickrisp/vulkan/kk_device.h
+++ b/src/kosmickrisp/vulkan/kk_device.h
@@ -126,6 +126,10 @@ struct kk_device {
    /* Track all heaps the user allocated so we can set them all as resident when
