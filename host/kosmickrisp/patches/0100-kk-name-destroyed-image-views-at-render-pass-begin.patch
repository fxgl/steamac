 vk_swizzle_to_pipe(VkComponentSwizzle swizzle)
@@ -458,6 +465,15 @@ kk_CreateImageView(VkDevice _device, const VkImageViewCreateInfo *pCreateInfo,
       return result;
    }
 
+   simple_mtx_lock(&dev->live_image_views_lock);
+   const bool tracked = _mesa_set_add(dev->live_image_views, view) != NULL;
+   simple_mtx_unlock(&dev->live_image_views_lock);
+   if (!tracked) {
+      kk_image_view_finish(dev, view);
+      vk_free2(&dev->vk.alloc, pAllocator, view);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
    *pView = kk_image_view_to_handle(view);
 
    return VK_SUCCESS;
@@ -473,10 +489,61 @@ kk_DestroyImageView(VkDevice _device, VkImageView imageView,
    if (!view)
       return;
 
+   simple_mtx_lock(&dev->live_image_views_lock);
+   _mesa_set_remove_key(dev->live_image_views, view);
+   simple_mtx_unlock(&dev->live_image_views_lock);
+
    kk_image_view_finish(dev, view);
    vk_free2(&dev->vk.alloc, pAllocator, view);
 }
 
+/* STEAMAC-BJ/BK: transition_attachment faulted reading image_view->image of a
+ * framebuffer attachment as NULL. The view pointer itself was set, and
+ * libmalloc clears freed blocks: the image view had been destroyed before the
+ * render pass began. Name such attachments before Mesa's common code
+ * dereferences them, so the next report shows which framebuffer, attachment
+ * and format it was. Recording continues unchanged. */
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginRenderPass2(VkCommandBuffer commandBuffer,
+                       const VkRenderPassBeginInfo *pRenderPassBeginInfo,
+                       const VkSubpassBeginInfo *pSubpassBeginInfo)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(vk_render_pass, pass, pRenderPassBeginInfo->renderPass);
+   VK_FROM_HANDLE(vk_framebuffer, framebuffer,
+                  pRenderPassBeginInfo->framebuffer);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   /* The same choice of views as vk_common_CmdBeginRenderPass2 */
+   const VkRenderPassAttachmentBeginInfo *attach_begin =
+      vk_find_struct_const(pRenderPassBeginInfo,
+                           RENDER_PASS_ATTACHMENT_BEGIN_INFO);
+   const bool imageless = attach_begin && attach_begin->attachmentCount != 0;
+   const VkImageView *views =
+      imageless ? attach_begin->pAttachments : framebuffer->attachments;
+
+   simple_mtx_lock(&dev->live_image_views_lock);
+   for (uint32_t a = 0; a < pass->attachment_count; a++) {
+      const void *view = kk_image_view_from_handle(views[a]);
+      if (view != NULL && _mesa_set_search(dev->live_image_views, view))
+         continue;
+      const struct vk_render_pass_attachment *att = &pass->attachments[a];
+      mesa_loge("kk: vkCmdBeginRenderPass: attachment %u/%u (%s, format %u, "
+                "samples %u) image view %p is %s; framebuffer %p %ux%ux%u",
+                a, pass->attachment_count,
+                imageless ? "imageless begin" : "framebuffer", att->format,
+                att->samples, view,
+                view == NULL ? "VK_NULL_HANDLE"
+                             : "not alive (destroyed before the render pass)",
+                framebuffer, framebuffer->width, framebuffer->height,
+                framebuffer->layers);
+   }
+   simple_mtx_unlock(&dev->live_image_views_lock);
+
+   vk_common_CmdBeginRenderPass2(commandBuffer, pRenderPassBeginInfo,
+                                 pSubpassBeginInfo);
+}
+
