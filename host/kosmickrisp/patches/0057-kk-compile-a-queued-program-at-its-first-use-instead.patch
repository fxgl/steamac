From 3a607e059271caeed8b6902425faa550e10167d4 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Wed, 14 Oct 2026 12:27:10 +0200
Subject: [PATCH] kk: compile a queued program at its first use instead of waiting for the queue

The first use of a program (a bind or a draw) waited for the compile
pool to reach it. With a title's whole pipeline set queued ahead, that is
the whole backlog: on Dragon's Dogma 2's first launch the game's first
draws after its compile screen waited behind thousands of programs. The
waiting thread was the ring thread executing a command stream, which
holds virglrenderer's submission lock that every guest context shares,
so the guest desktop froze for minutes too.

A program that is still queued when it is needed is now taken out of
the queue and compiled right away by the thread that needs it; one that
a worker is already compiling is waited for as before. Measured on the
same first launch: the game goes from its compile screen to rendering
gameplay without a stall, ~9 minutes after launch.

Generated-by: LLM
---
 src/kosmickrisp/vulkan/kk_shader.c | 34 +++++++++++++++++++++++++++++-
 src/kosmickrisp/vulkan/kk_shader.h |  2 ++
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index 218345e..6aab85b 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -2487,7 +2487,8 @@ kk_compile_program(struct kk_device *dev, struct kk_shader *s,
  * compilation (Dragon's Dogma 2: ~1,100 programs and ~130,000 pipelines, which
  * measured 62 minutes of first-run compilation). Programs are queued at
  * creation and compiled here instead, on as many threads as the machine has
- * cores; the first use of a program, and its destruction, wait for its compile.
+ * cores. The first use of a program compiles it if it is still queued, or waits
+ * for the worker compiling it; its destruction leaves it to that worker.
  * The pool shares the Metal compiler (safe to use concurrently) and the
  * device's compiled-library table (`msl_libraries_lock`). */
 static int
@@ -2507,6 +2508,7 @@ kk_compile_worker(void *data)
       if (dev->compile_head == NULL)
          dev->compile_tail = NULL;
       s->compile_next = NULL;
+      s->compile_running = true;
       /* Nothing will use a destroyed program once the device goes away */
       const bool skip = s->compile_orphaned && dev->compile_shutdown;
       mtx_unlock(&dev->compile_mtx);
@@ -2609,6 +2611,36 @@ kk_compile_wait(struct kk_device *dev, struct kk_shader *s)
       return VK_SUCCESS;
 
    mtx_lock(&dev->compile_mtx);
+   if (s->compile_queued && !s->compile_running && !s->compile_done) {
+      /* First use of a program that is still in the queue: a title's whole
+       * pipeline set can be queued ahead of it, and the thread waiting here
+       * (a bind or draw on the ring thread, under virglrenderer's submission
+       * lock that every guest context shares) would wait for all of it -
+       * Dragon's Dogma 2's desktop froze for minutes after its compile screen.
+       * Take it out of the queue and compile it now. */
+      struct kk_shader **link = &dev->compile_head, *prev = NULL;
+      while (*link != s) {
+         prev = *link;
+         link = &(*link)->compile_next;
+      }
+      *link = s->compile_next;
+      if (dev->compile_tail == s)
+         dev->compile_tail = prev;
+      s->compile_next = NULL;
+      s->compile_running = true;
+      mtx_unlock(&dev->compile_mtx);
+
+      const VkResult result =
+         kk_compile_program(dev, s, dev->mtl_compiler_handle);
+
+      mtx_lock(&dev->compile_mtx);
+      s->compile_result = result;
+      s->compile_done = true;
+      dev->compile_pending--;
+      cnd_broadcast(&dev->compile_cnd);
+      mtx_unlock(&dev->compile_mtx);
+      return result;
+   }
    while (!s->compile_done && s->compile_queued)
       cnd_wait(&dev->compile_cnd, &dev->compile_mtx);
    const bool done = s->compile_done;
diff --git a/src/kosmickrisp/vulkan/kk_shader.h b/src/kosmickrisp/vulkan/kk_shader.h
index 7ce33d2..0efb9d6 100644
--- a/src/kosmickrisp/vulkan/kk_shader.h
+++ b/src/kosmickrisp/vulkan/kk_shader.h
@@ -179,6 +179,8 @@ struct kk_shader {
     * for compile_done; destruction does not (compile_orphaned). */
    struct kk_shader *compile_next;
    bool compile_queued;
+   /* A worker (or a thread that needed it first) is compiling it */
+   bool compile_running;
    bool compile_done;
    VkResult compile_result;
    /* Destroyed while queued or compiling: the worker that compiles it frees
