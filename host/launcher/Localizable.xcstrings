        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "диск SteamOS %@ используется другим FX Steam Launcher (или steamac-vm). Сначала завершите его работу: две ВМ, записывающие данные на один диск, повреждают его файловые системы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
