        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamOS 会正常关机，并使用新设置重新启动。"
          }
        }
      }
    },
    "SteamOS suspended" : {
      "comment" : "The whole VM is frozen in memory, not a paused game",
      "localizations" : {
