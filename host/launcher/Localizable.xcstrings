        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中选择的映像无法读取：\n%@\n\n"
          }
        }
      }
    },
    "The installed libkrun has no %@ (rebuild host/libkrun and reinstall the launcher)." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В установленной libkrun нет %@ (пересоберите host/libkrun и переустановите приложение)."
