      }
    },
    "SteamOS will shut down normally, the image will be enlarged while it is stopped, then restart." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamOS корректно выключится, образ будет увеличен, пока она остановлена, после чего она запустится снова."
          }
        },
        "zh-Hans" : {
