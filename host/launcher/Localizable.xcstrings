            "value" : "最小化"
          }
        }
      }
    },
    "More than this Mac's %lld performance cores. The extra vCPUs run on efficiency cores, which slows the guest down and leaves fewer cores for the Mac's GPU work." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Больше, чем %lld производительных ядра этого Mac. Дополнительные vCPU работают на энергоэффективных ядрах, что замедляет гостевую систему и оставляет меньше ядер для работы GPU Mac."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Больше, чем %lld производительных ядер этого Mac. Дополнительные vCPU работают на энергоэффективных ядрах, что замедляет гостевую систему и оставляет меньше ядер для работы GPU Mac."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Больше, чем %lld производительное ядро этого Mac. Дополнительные vCPU работают на энергоэффективных ядрах, что замедляет гостевую систему и оставляет меньше ядер для работы GPU Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Больше, чем %lld производительного ядра этого Mac. Дополнительные vCPU работают на энергоэффективных ядрах, что замедляет гостевую систему и оставляет меньше ядер для работы GPU Mac."
                }
