          }
        }
      }
    },
    "The launcher's last ~200 log lines (launcher, MoltenVK, libkrun and virglrenderer messages; home folder paths shortened to ~) and the boot stages." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
