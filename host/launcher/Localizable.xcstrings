    "Microphone: the guest records from the macOS default input; macOS asks for permission the first time." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон: гостевая система записывает звук с устройства ввода macOS по умолчанию; при первом использовании macOS запросит разрешение."
          }
        },
        "zh-Hans" : {
