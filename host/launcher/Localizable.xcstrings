    },
    "%@ GB free there; about 14 GB are needed (the disk is sparse) plus ~6 GB of download cache." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь свободно %@ ГБ; потребуется около 14 ГБ (образ диска разреженный) и ещё ~6 ГБ для кэша загрузки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该位置有 %@ GB 可用空间；约需 14 GB（磁盘为稀疏文件），另需约 6 GB 下载缓存空间。"
          }
        }
      }
    },
    "%@ MB · %@ MB/s" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ MB · %2$@ MB/s"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ МБ · %@ МБ/с"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MB · %@ MB/s"
          }
        }
      }
    },
    "%@ already exists (never overwritten; delete it or choose another path)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже существует (файл никогда не перезаписывается; удалите его или выберите другой путь)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已存在（不会覆盖；请删除该文件或选择其他路径）"
          }
        }
      }
    },
    "%@ is on a FAT32/MS-DOS volume, which cannot store files of 4 GiB or larger. The SteamOS disk and its 10 GiB rootfs exceed this limit: choose an APFS, Mac OS Extended, or exFAT volume" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ находится на томе FAT32/MS-DOS, который не поддерживает файлы размером 4 GiB и больше. Диск SteamOS и его rootfs размером 10 GiB превышают этот предел: выберите том APFS, Mac OS Extended или exFAT"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 位于 FAT32/MS-DOS 宗卷上，无法存储大小达到或超过 4 GiB 的文件。SteamOS 磁盘及其 10 GiB rootfs 均超出此限制：请选择 APFS、Mac OS Extended 或 exFAT 宗卷"
          }
        }
      }
    },
    "%@ is on a read-only volume: choose a writable location for the SteamOS disk" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ находится на томе только для чтения: выберите место для диска SteamOS с доступом на запись"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 位于只读宗卷上：请为 SteamOS 磁盘选择可写入的位置"
          }
        }
      }
    },
    "%@ of memory in use" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется %@ памяти"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用 %@ 内存"
          }
        }
      }
    },
