+ * bound it or will fail. The caller checks the streams, then frees it. */
+static struct vkr_resource *
+vkr_context_unpublish_resource(struct vkr_context *ctx, uint32_t res_id)
 {
    mtx_lock(&ctx->resource_mutex);
    struct hash_entry *entry = _mesa_hash_table_search(ctx->resource_table, &res_id);
+   struct vkr_resource *res = NULL;
    if (likely(entry)) {
-      vkr_context_free_resource(entry);
+      res = entry->data;
       _mesa_hash_table_remove(ctx->resource_table, entry);
       const uint32_t slot = ctx->resources_detached++ % ARRAY_SIZE(ctx->detached);
       ctx->detached[slot].res_id = res_id;
       ctx->detached[slot].time_ns = vkr_context_now_ns();
    }
    mtx_unlock(&ctx->resource_mutex);
+   return res;
 }
 
