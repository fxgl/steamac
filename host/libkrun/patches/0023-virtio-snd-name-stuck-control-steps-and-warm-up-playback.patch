@@ -2504,6 +2520,24 @@ impl CoreAudioBackend {
             .name("virtio-snd coreaudio".into())
             .spawn(move || pump_thread(pump_inner))
             .map_err(|e| Error::UnexpectedAudioBackendError(e.to_string()))?;
+        // Create the playback unit while the guest boots: on a cold CoreAudio the first
+        // AudioComponentInstanceNew/CurrentDevice took 2 s here, longer than the guest's 1 s
+        // control timeout, so its first PCM_PREPARE (and the SET_PARAMS behind it) timed out
+        // (STEAMAC-DA). PREPARE waits on the stream lock if this is still running.
+        let warm_inner = inner.clone();
+        std::thread::Builder::new()
+            .name("virtio-snd warm-up".into())
+            .spawn(move || {
+                for host in &warm_inner.hosts {
+                    let mut host = host.lock().unwrap();
+                    if host.direction == Direction::Output && host.unit.is_none() {
+                        if let Err(err) = host.create_unit() {
