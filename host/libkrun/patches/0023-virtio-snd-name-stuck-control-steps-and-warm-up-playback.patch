 use super::{stream::Stream, BackendType, Result, SndControl, VirtioSndPcmSetParams};
 
+/// Process-wide (one virtio-snd device per VM process): logs a control request still
+/// running past the guest's timeout, naming the host step it is in (STEAMAC-DA).
+#[cfg(target_os = "macos")]
+static CONTROL_WATCHDOG: std::sync::LazyLock<Option<control_watchdog::ControlWatchdog>> =
+    std::sync::LazyLock::new(|| {
+        control_watchdog::ControlWatchdog::new(control_watchdog::STUCK_AFTER, |m| {
+            log::warn!("{m}")
+        })
+        .map_err(|err| log::warn!("snd: control watchdog unavailable: {err}"))
+        .ok()
+    });
+
+/// Marks one control request in flight until dropped.
+pub(super) struct ControlRequest(());
+
+impl ControlRequest {
+    pub(super) fn begin(_what: &'static str) -> Self {
+        #[cfg(target_os = "macos")]
+        if let Some(dog) = CONTROL_WATCHDOG.as_ref() {
+            dog.begin(_what);
+        }
+        Self(())
+    }
+}
+
+impl Drop for ControlRequest {
+    fn drop(&mut self) {
+        #[cfg(target_os = "macos")]
+        if let Some(dog) = CONTROL_WATCHDOG.as_ref() {
+            dog.end();
+        }
+    }
+}
+
+/// Names the host step the current control request is in.
+#[cfg(target_os = "macos")]
+fn control_stage(stage: &'static str) {
+    if let Some(dog) = CONTROL_WATCHDOG.as_ref() {
+        dog.stage(stage);
+    }
+}
+
 pub trait AudioBackend {
     fn write(&self, stream_id: u32) -> Result<()>;
 
diff --git a/src/devices/src/virtio/snd/audio_backends/control_watchdog.rs b/src/devices/src/virtio/snd/audio_backends/control_watchdog.rs
new file mode 100644
index 0000000..bfdf69d
--- /dev/null
+++ b/src/devices/src/virtio/snd/audio_backends/control_watchdog.rs
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: Apache-2.0 or BSD-3-Clause
+// Name the step a virtio-snd control request is stuck in. The guest gives up on a control
+// message after 1 s ("virtio_snd: control message (0x00000102) timeout") and keeps retrying,
+// while a worker blocked in a CoreAudio call logs nothing (STEAMAC-DA: PCM_PREPARE timed out
+// every few seconds from boot on, no host-side line at all).
+use std::sync::{Arc, Condvar, Mutex};
+use std::thread::{self, ThreadId};
+use std::time::{Duration, Instant};
+
+/// The guest's virtio_snd control timeout (msg_timeout_ms, 1000 by default).
+pub(super) const STUCK_AFTER: Duration = Duration::from_millis(1000);
+/// A request that finished but took this long is logged with its slowest step.
+pub(super) const SLOW_AFTER: Duration = Duration::from_millis(250);
+
+struct Request {
+    what: &'static str,
+    started: Instant,
+    stage: &'static str,
+    stage_started: Instant,
+    slowest: (&'static str, Duration),
+    reported: bool,
+    /// Only this thread's steps describe the request; the pump, capture and warm-up
+    /// threads run the same setup code for themselves.
+    thread: ThreadId,
+}
+
+#[derive(Default)]
+struct State {
+    current: Option<Request>,
+    quit: bool,
+}
+
+pub(super) struct ControlWatchdog {
+    shared: Arc<(Mutex<State>, Condvar)>,
+    report: Arc<dyn Fn(String) + Send + Sync>,
+}
+
+impl ControlWatchdog {
+    pub(super) fn new(
+        stuck_after: Duration,
+        report: impl Fn(String) + Send + Sync + 'static,
+    ) -> std::io::Result<Self> {
+        let shared = Arc::new((Mutex::new(State::default()), Condvar::new()));
+        let report: Arc<dyn Fn(String) + Send + Sync> = Arc::new(report);
+        let (watched, log) = (shared.clone(), report.clone());
+        std::thread::Builder::new()
+            .name("virtio-snd watchdog".into())
+            .spawn(move || {
+                let (lock, cvar) = &*watched;
+                let mut state = lock.lock().unwrap();
+                while !state.quit {
+                    let mut message = None;
+                    if let Some(req) = state.current.as_mut() {
+                        if !req.reported && req.started.elapsed() >= stuck_after {
+                            req.reported = true;
+                            message = Some(format!(
+                                "snd: control {} still running after {} ms, in {} for {} ms \
+                                 (the guest has timed out; its audio fails until it returns)",
+                                req.what,
+                                req.started.elapsed().as_millis(),
+                                req.stage,
+                                req.stage_started.elapsed().as_millis()
+                            ));
+                        }
+                    }
+                    if let Some(message) = message {
+                        drop(state);
+                        log(message);
+                        state = lock.lock().unwrap();
+                        continue;
+                    }
+                    state = cvar
+                        .wait_timeout(state, Duration::from_millis(100))
+                        .unwrap()
+                        .0;
+                }
+            })?;
+        Ok(Self { shared, report })
+    }
+
+    pub(super) fn begin(&self, what: &'static str) {
+        let now = Instant::now();
+        self.shared.0.lock().unwrap().current = Some(Request {
+            what,
+            started: now,
+            stage: "the device",
+            stage_started: now,
+            slowest: ("the device", Duration::ZERO),
+            reported: false,
+            thread: thread::current().id(),
+        });
+    }
+
+    pub(super) fn stage(&self, stage: &'static str) {
+        let mut state = self.shared.0.lock().unwrap();
+        if let Some(req) = state.current.as_mut().filter(|r| r.thread == thread::current().id()) {
+            let spent = req.stage_started.elapsed();
+            if spent > req.slowest.1 {
+                req.slowest = (req.stage, spent);
+            }
+            req.stage = stage;
+            req.stage_started = Instant::now();
+        }
+    }
+
+    pub(super) fn end(&self) {
+        let Some(mut req) = self.shared.0.lock().unwrap().current.take() else {
+            return;
+        };
+        let spent = req.stage_started.elapsed();
+        if spent > req.slowest.1 {
+            req.slowest = (req.stage, spent);
+        }
+        let total = req.started.elapsed();
+        if req.reported || total >= SLOW_AFTER {
+            (self.report)(format!(
+                "snd: control {} finished after {} ms (slowest step: {}, {} ms)",
+                req.what,
+                total.as_millis(),
+                req.slowest.0,
+                req.slowest.1.as_millis()
+            ));
+        }
+    }
+}
+
+impl Drop for ControlWatchdog {
+    fn drop(&mut self) {
+        self.shared.0.lock().unwrap().quit = true;
+        self.shared.1.notify_all();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::mpsc;
+
+    fn watchdog(stuck: Duration) -> (ControlWatchdog, mpsc::Receiver<String>) {
+        let (tx, rx) = mpsc::channel();
+        let tx = Mutex::new(tx);
+        let dog = ControlWatchdog::new(stuck, move |m| tx.lock().unwrap().send(m).unwrap()).unwrap();
+        (dog, rx)
+    }
+
+    #[test]
+    fn a_stuck_request_is_reported_once_with_its_step_while_still_blocked() {
+        let (dog, rx) = watchdog(Duration::from_millis(50));
+        dog.begin("PCM_PREPARE");
+        dog.stage("playback AudioUnitInitialize");
+        // The audio pump running the same setup code for itself does not relabel it.
+        std::thread::scope(|s| {
+            s.spawn(|| dog.stage("AudioOutputUnitStart"));
+        });
+        // Still blocked: the report must arrive without end().
+        let stuck = rx.recv_timeout(Duration::from_secs(2)).unwrap();
+        assert!(stuck.contains("PCM_PREPARE still running after"), "{stuck}");
+        assert!(stuck.contains("in playback AudioUnitInitialize for"), "{stuck}");
+        assert!(rx.recv_timeout(Duration::from_millis(200)).is_err(), "reported twice");
+        dog.end();
+        let done = rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        assert!(done.contains("PCM_PREPARE finished after"), "{done}");
+        assert!(done.contains("slowest step: playback AudioUnitInitialize"), "{done}");
+    }
+
+    #[test]
+    fn fast_requests_log_nothing_and_slow_ones_name_the_slowest_step() {
+        let (dog, rx) = watchdog(Duration::from_secs(5));
+        dog.begin("PCM_START");
+        dog.stage("playback AudioOutputUnitStart");
+        dog.end();
+        assert!(rx.recv_timeout(Duration::from_millis(200)).is_err());
+
+        dog.begin("PCM_PREPARE");
+        dog.stage("playback output unit creation");
+        std::thread::sleep(Duration::from_millis(10));
+        dog.stage("playback AudioOutputUnitStart");
+        std::thread::sleep(SLOW_AFTER + Duration::from_millis(20));
+        dog.end();
+        let done = rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        assert!(done.contains("slowest step: playback AudioOutputUnitStart"), "{done}");
+        assert!(!done.contains("still running"), "{done}");
+    }
+}
