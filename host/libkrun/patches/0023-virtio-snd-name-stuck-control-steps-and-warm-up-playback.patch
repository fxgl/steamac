+        control_stage("the playback stream lock (held by the audio pump or warm-up)");
         let mut host = self.inner.hosts[stream_id as usize].lock().unwrap();
         let host = &mut *host;
         self.trace(host, "PREPARE");
+        control_stage("AudioOutputUnitStop");
         host.stop_unit();
