--- a/src/devices/src/virtio/snd/mod.rs
+++ b/src/devices/src/virtio/snd/mod.rs
@@ -361,6 +361,23 @@ pub enum ControlMessageKind {
     ChmapInfo = 0x0200,
 }
 
+impl ControlMessageKind {
+    /// The spec name; the guest's virtio_snd timeout message identifies it by code.
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::JackInfo => "JACK_INFO",
+            Self::JackRemap => "JACK_REMAP",
+            Self::PcmInfo => "PCM_INFO",
+            Self::PcmSetParams => "PCM_SET_PARAMS",
+            Self::PcmPrepare => "PCM_PREPARE (0x0102)",
+            Self::PcmRelease => "PCM_RELEASE (0x0103)",
+            Self::PcmStart => "PCM_START (0x0104)",
+            Self::PcmStop => "PCM_STOP (0x0105)",
+            Self::ChmapInfo => "CHMAP_INFO",
+        }
+    }
+}
+
 impl TryFrom<u32> for ControlMessageKind {
     type Error = InvalidControlMessage;
 
