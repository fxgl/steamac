+++ b/src/devices/src/virtio/snd/audio_backends/capture.rs
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: Apache-2.0 or BSD-3-Clause
+// Keep potentially blocking microphone/TCC calls off virtio's control and playback threads.
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{mpsc, Arc};
+use std::time::Duration;
+
+const START_TIMEOUT: Duration = Duration::from_millis(200);
+
+pub(super) enum Operation<P> {
+    Start(P),
+    Stop,
+    Poll,
+}
+
+enum Command<P> {
+    Start(P, u64, mpsc::SyncSender<Result<(), String>>),
+    Stop,
+}
+
+pub(super) struct CaptureWorker<P> {
+    tx: mpsc::SyncSender<Command<P>>,
+    generation: Arc<AtomicU64>,
+    pending: Arc<AtomicBool>,
+    quit: Arc<AtomicBool>,
+}
+
+impl<P: Send + 'static> CaptureWorker<P> {
+    pub(super) fn new(
+        mut handle: impl FnMut(Operation<P>) -> Result<(), String> + Send + 'static,
+    ) -> std::io::Result<Self> {
+        let (tx, rx) = mpsc::sync_channel(1);
+        let generation = Arc::new(AtomicU64::new(0));
+        let pending = Arc::new(AtomicBool::new(false));
+        let quit = Arc::new(AtomicBool::new(false));
+        let (epoch, busy, done) = (generation.clone(), pending.clone(), quit.clone());
+        // Do not join on drop: a system audio API can be waiting for a permission dialog.
+        // The worker owns its audio resources until that call returns, then stops them.
+        std::thread::Builder::new()
+            .name("virtio-snd capture".into())
+            .spawn(move || {
+                while !done.load(Ordering::Acquire) {
+                    match rx.recv_timeout(Duration::from_secs(1)) {
+                        Ok(Command::Start(params, requested, reply)) => {
+                            let result = if epoch.load(Ordering::Acquire) == requested {
+                                handle(Operation::Start(params))
+                            } else {
+                                Err("capture start canceled".into())
+                            };
+                            let failed = result.is_err();
+                            if epoch.load(Ordering::Acquire) != requested
+                                || reply.send(result).is_err()
+                                || failed
+                            {
+                                let _ = handle(Operation::Stop);
+                            }
+                            busy.store(false, Ordering::Release);
+                        }
+                        Ok(Command::Stop) => { let _ = handle(Operation::Stop); }
+                        Err(mpsc::RecvTimeoutError::Timeout) => { let _ = handle(Operation::Poll); }
+                        Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                    }
+                }
+                let _ = handle(Operation::Stop);
+            })?;
+        Ok(Self { tx, generation, pending, quit })
+    }
+
+    pub(super) fn start(&self, params: P) -> Result<(), String> {
+        if self.pending.swap(true, Ordering::AcqRel) {
+            return Err("capture device is still starting/stopping".into());
+        }
+        let (tx, rx) = mpsc::sync_channel(0);
+        let epoch = self.generation.load(Ordering::Acquire);
+        if self.tx.try_send(Command::Start(params, epoch, tx)).is_err() {
+            self.pending.store(false, Ordering::Release);
+            return Err("capture worker is busy".into());
+        }
+        match rx.recv_timeout(START_TIMEOUT) {
+            Ok(result) => result,
+            Err(_) => {
+                self.stop();
+                Err("capture start exceeded 200 ms (microphone permission/device); request failed, late start canceled".into())
+            }
+        }
+    }
+
+    pub(super) fn stop(&self) {
+        self.generation.fetch_add(1, Ordering::AcqRel);
+        // A full queue contains either Stop or a Start canceled by the generation above.
+        let _ = self.tx.try_send(Command::Stop);
+    }
+}
+
+impl<P> Drop for CaptureWorker<P> {
+    fn drop(&mut self) {
+        self.generation.fetch_add(1, Ordering::AcqRel);
+        self.quit.store(true, Ordering::Release);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+    use std::time::Instant;
+
+    #[test]
+    fn blocked_start_times_out_and_late_start_is_stopped() {
+        let (entered_tx, entered_rx) = mpsc::channel();
+        let (unblock_tx, unblock_rx) = mpsc::channel();
+        let (stopped_tx, stopped_rx) = mpsc::channel();
+        let worker = CaptureWorker::new(move |op| {
+            match op {
+                Operation::Start(()) => {
+                    entered_tx.send(()).unwrap();
+                    unblock_rx.recv().unwrap();
+                }
+                Operation::Stop => { let _ = stopped_tx.send(()); }
+                Operation::Poll => (),
+            }
+            Ok(())
+        }).unwrap();
+        let before = Instant::now();
+        assert!(worker.start(()).unwrap_err().contains("exceeded 200 ms"));
+        assert!(before.elapsed() < Duration::from_secs(1));
+        entered_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        let before = Instant::now();
+        worker.stop();
+        assert!(worker.start(()).is_err());
+        assert!(before.elapsed() < Duration::from_millis(100));
+        unblock_tx.send(()).unwrap();
+        stopped_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+    }
+
+    #[test]
+    fn successful_and_failed_starts_complete_and_stop_is_nonblocking() {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let events = seen.clone();
+        let worker = CaptureWorker::new(move |op| {
+            match op {
+                Operation::Start(fail) => {
+                    events.lock().unwrap().push("start");
+                    if fail { return Err("no input device".into()); }
+                }
+                Operation::Stop => events.lock().unwrap().push("stop"),
+                Operation::Poll => (),
+            }
+            Ok(())
+        }).unwrap();
+        assert!(worker.start(false).is_ok());
+        // Pending is cleared after the rendezvous; wait for the worker's next dispatch.
+        while worker.pending.load(Ordering::Acquire) { std::thread::yield_now(); }
+        assert_eq!(worker.start(true).unwrap_err(), "no input device");
+        worker.stop();
+        assert_eq!(seen.lock().unwrap()[0], "start");
+    }
+}
