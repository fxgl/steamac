+        return None;
+    }
+    let channels: usize = (0..count)
+        .map(|i| {
+            u32::from_ne_bytes(
+                bytes[offset + i * stride..offset + i * stride + 4]
+                    .try_into()
+                    .unwrap(),
+            ) as usize
+        })
+        .sum();
+    (channels > 0).then_some(channels)
