+fn device_channels(device: AudioObjectID) -> Option<usize> {
+    let bytes = property_bytes(device, kAudioDevicePropertyStreamConfiguration)?;
+    let count = u32::from_ne_bytes(bytes.get(..4)?.try_into().ok()?) as usize;
