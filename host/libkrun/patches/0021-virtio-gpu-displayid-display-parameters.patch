+
+    #[test]
+    fn displayid_parameters_describe_the_virtual_display() {
+        let params = EdidParams {
+            refresh_rate: 240,
+            physical_size: PhysicalSize::DimensionsMillimeters(600, 340),
+        };
+        let edid = EdidInfo::new(3840, 2160, &params).bytes();
+        checksums(&edid);
+        assert_eq!(
+            &edid[133..148],
+            &[
+                1, 0, 12, 0x70, 0x17, 0x48, 0x0d, // 600.0 x 340.0 mm
+                0x00, 0x0f, 0x70, 0x08, // Direct native counts: 3840 x 2160
+                0, 0xff, 76, 0x77, // No features; unspecified gamma; 1.76 aspect; 8 bpc
+            ]
+        );
+        assert_eq!(&edid[148..151], &[3, 0, 20]);
+    }
+
+    #[test]
+    fn displayid_physical_size_preserves_existing_dpi_units() {
+        let params = EdidParams {
+            refresh_rate: 240,
+            ..Default::default()
+        };
+        let info = EdidInfo::new(3840, 2160, &params);
+        // Existing 300-DPI conversion truncates to whole millimetres. Do not
+        // reinterpret those values as centimetres or change legacy conversion.
+        assert_eq!(
+            (info.width_millimeters, info.height_millimeters),
+            (325, 182)
+        );
+        let edid = info.bytes();
+        assert_eq!(u16::from_le_bytes([edid[136], edid[137]]), 3250);
+        assert_eq!(u16::from_le_bytes([edid[138], edid[139]]), 1820);
+        checksums(&edid);
+    }
+
+    #[test]
+    fn displayid_physical_sizes_do_not_wrap_or_invent_dimensions() {
+        for (wmm, hmm, expected) in [
+            (6553, 6553, (65530u16, 65530u16)),
+            (6554, 340, (0, 0)),
+            (600, 6554, (0, 0)),
+            (u16::MAX, u16::MAX, (0, 0)),
+            (0, 340, (0, 0)),
+            (600, 0, (0, 0)),
+            (0, 0, (0, 0)),
+        ] {
+            let params = EdidParams {
+                refresh_rate: 240,
+                physical_size: PhysicalSize::DimensionsMillimeters(wmm, hmm),
+            };
+            let edid = EdidInfo::new(3840, 2160, &params).bytes();
+            assert_eq!(&edid[136..138], &expected.0.to_le_bytes());
+            assert_eq!(&edid[138..140], &expected.1.to_le_bytes());
+            assert_eq!(edid[146], if expected.0 == 0 { 78 } else { 0 });
+            checksums(&edid);
+        }
+        // Invalid/extreme configured DPI remains unchanged in the legacy path,
+        // but saturated/zero millimetres must not become misleading DisplayID sizes.
+        for dpi in [0, 1, u32::MAX] {
+            let params = EdidParams {
+                refresh_rate: 240,
+                physical_size: PhysicalSize::Dpi(dpi),
+            };
+            let edid = EdidInfo::new(3840, 2160, &params).bytes();
+            assert_eq!(&edid[136..140], &[0, 0, 0, 0]);
+            assert_eq!(edid[146], 78); // Fall back to native 16:9 ratio.
+            checksums(&edid);
+        }
+    }
+
+    #[test]
+    fn displayid_native_pixel_counts_use_checked_direct_values() {
+        let mut info = EdidInfo::new(3840, 2160, &EdidParams::default());
+        for (width, height, expected) in [
+            (1, 1, (1u16, 1u16)),
+            (65535, 65535, (65535, 65535)),
+            (65536, 2160, (0, 0)),
+            (3840, 65536, (0, 0)),
+            (u32::MAX, u32::MAX, (0, 0)),
+            (0, 2160, (0, 0)),
+            (3840, 0, (0, 0)),
+        ] {
+            info.width = width;
+            info.height = height;
+            let mut block = [0; 15];
+            populate_displayid_parameters(&mut block, &info);
+            assert_eq!(&block[7..9], &expected.0.to_le_bytes());
+            assert_eq!(&block[9..11], &expected.1.to_le_bytes());
+        }
+    }
+
+    #[test]
+    fn displayid_aspect_ratios_have_explicit_rounding_and_saturation() {
+        for (w, h, expected) in [
+            (1, 1, 0),
+            (16, 9, 78),
+            (9, 16, 78),
+            (600, 340, 76),
+            (340, 600, 76),
+            (355, 100, 255),
+            (356, 100, 255),
+            (100, 356, 255),
+            (u32::MAX, 1, 255),
+            (1, u32::MAX, 255),
+            (u32::MAX, u32::MAX, 0),
+            (0, 1, 0),
+            (1, 0, 0),
+            (0, 0, 0),
+        ] {
+            assert_eq!(displayid_aspect_ratio(w, h), expected, "{w}:{h}");
+        }
+        // Exercise the encoder, not just its ratio helper, at the upper boundary.
+        for (wmm, hmm, expected) in [(355, 100, 255), (356, 100, 255), (100, 356, 255)] {
+            let params = EdidParams {
+                refresh_rate: 240,
+                physical_size: PhysicalSize::DimensionsMillimeters(wmm, hmm),
+            };
+            let edid = EdidInfo::new(3840, 2160, &params).bytes();
+            assert_eq!(edid[146], expected);
+            checksums(&edid);
+        }
+    }
+}
