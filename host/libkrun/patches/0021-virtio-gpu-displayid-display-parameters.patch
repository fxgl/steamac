+
+// DisplayID 1.3 Display Parameters (tag 0x01, revision 0, 12-byte payload).
+// These dimensions are direct values, NOT the Type I timing's value-minus-one.
+fn populate_displayid_parameters(block: &mut [u8], info: &EdidInfo) {
+    assert_eq!(block.len(), 15);
+    block[..3].copy_from_slice(&[1, 0, 12]);
+
+    // EdidInfo holds whole millimetres supplied by the caller or derived from
+    // configured DPI. They describe the virtual display, not a measured host panel.
+    // Widen before converting to 0.1 mm; zero means unspecified in this block.
+    let (width_mm, height_mm) = displayid_dimensions(
+        u32::from(info.width_millimeters) * 10,
+        u32::from(info.height_millimeters) * 10,
+    );
+    block[3..5].copy_from_slice(&width_mm.to_le_bytes());
+    block[5..7].copy_from_slice(&height_mm.to_le_bytes());
+    let (width, height) = displayid_dimensions(info.width, info.height);
+    block[7..9].copy_from_slice(&width.to_le_bytes());
+    block[9..11].copy_from_slice(&height.to_le_bytes());
+    block[11] = 0; // No fixed format/timing, audio-on-video or power features claimed.
+    block[12] = 0xff; // Gamma unspecified.
+    block[13] = if width_mm != 0 {
+        displayid_aspect_ratio(u32::from(width_mm), u32::from(height_mm))
+    } else {
+        displayid_aspect_ratio(info.width, info.height)
+    };
+    block[14] = 0x77; // Virtual scanout: 8 bpc native and overall (stored minus one).
+}
+
+// Keep a dimension pair coherent. Do not wrap, clamp sizes or invent one axis
+// when either is zero or cannot fit: both fields become unspecified instead.
+fn displayid_dimensions(width: u32, height: u32) -> (u16, u16) {
+    match (u16::try_from(width), u16::try_from(height)) {
+        (Ok(w), Ok(h)) if w != 0 && h != 0 => (w, h),
+        _ => (0, 0),
+    }
+}
+
+// The aspect field has no unspecified sentinel: it encodes 1.00 + byte / 100.
+// Normalize portrait ratios to long/short, round to hundredths and explicitly
+// saturate at 3.55. This is lossy metadata for extreme ratios; timing is unchanged.
+// With no usable ratio, use the valid 1:1 fallback, not an invented sentinel.
+fn displayid_aspect_ratio(width: u32, height: u32) -> u8 {
+    let long = u64::from(width.max(height));
+    let short = u64::from(width.min(height));
+    if short == 0 {
+        return 0;
+    }
+    (((long - short) * 100 + short / 2) / short).min(u64::from(u8::MAX)) as u8
 }
 
 fn populate_display_name(edid_block: &mut [u8]) {
