+  /* WMTR_GPU_FAULT_INFO=1 (launcher environment): per-encoder fault reports; off by default */
+  static int fault_info = -1;
+  if (fault_info < 0) {
+    const char *v = getenv("WMTR_GPU_FAULT_INFO");
+    fault_info = v && v[0] == '1';
+  }
+  if (!fault_info) {
+    params->ret = (obj_handle_t)[(id<MTLCommandQueue>)params->handle commandBuffer];
+    return STATUS_SUCCESS;
+  }
+  MTLCommandBufferDescriptor *desc = [[MTLCommandBufferDescriptor alloc] init];
+  desc.errorOptions = MTLCommandBufferErrorOptionEncoderExecutionStatus;
+  id<MTLCommandBuffer> cb = [(id<MTLCommandQueue>)params->handle commandBufferWithDescriptor:desc];
+  [desc release];
+  [cb addCompletedHandler:^(id<MTLCommandBuffer> done) { log_failed_encoders(done); }];
+  params->ret = (obj_handle_t)cb;
   return STATUS_SUCCESS;
 }
 
