+/* Logs which encoders of a failed command buffer faulted (label + state), for the first few failures:
+ * a GPU page fault or hang is otherwise reported for the whole command buffer only. */
+static void
+log_failed_encoders(id<MTLCommandBuffer> cb) {
+  static atomic_int logged;
+  NSError *err = cb.error;
+  if (!err || err.code == MTLCommandBufferErrorNotPermitted || err.code == 4 /* SubmissionsIgnored */)
+    return;
+  if (atomic_fetch_add(&logged, 1) >= 16)
+    return;
+  static const char *states[] = {"unknown", "completed", "affected", "pending", "faulted"};
+  fprintf(stderr, "wmtr-gpu-fault: command buffer failed (%ld): %s\n", (long)err.code,
+          err.localizedDescription.UTF8String);
+  NSArray *infos = err.userInfo[MTLCommandBufferEncoderInfoErrorKey];
+  for (id<MTLCommandBufferEncoderInfo> info in infos) {
+    MTLCommandEncoderErrorState s = info.errorState;
+    fprintf(stderr, "wmtr-gpu-fault:   encoder %-9s %s%s\n", (unsigned)s < 5 ? states[s] : "?",
+            info.label.length ? info.label.UTF8String : "(no label)",
+            info.debugSignposts.count ? [[info.debugSignposts componentsJoinedByString:@" > "] UTF8String] : "");
+  }
+}
