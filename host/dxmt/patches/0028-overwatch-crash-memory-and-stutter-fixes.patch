+// "draws=N <vs/ps> <vs/ps> ..." for the pipelines a render pass binds (first 32 distinct)
+static std::string
+DescribeRenderCommands(const wmtcmd_render_nop *head) {
+  unsigned draws = 0, named = 0;
+  obj_handle_t seen[32] = {};
+  std::string names;
+  std::lock_guard<dxmt::mutex> lock(pipeline_names_mutex);
+  for (auto cmd = (const wmtcmd_base *)head->next.ptr; cmd; cmd = (const wmtcmd_base *)cmd->next.ptr) {
+    if (cmd->type >= WMTRenderCommandDraw && cmd->type <= WMTRenderCommandDrawMeshThreadgroupsIndirect) {
+      draws++;
+    } else if (cmd->type == WMTRenderCommandSetPSO && named < 32) {
+      auto pso = ((const wmtcmd_render_setpso *)cmd)->pso;
+      if (std::find(seen, seen + named, pso) != seen + named)
+        continue;
+      seen[named++] = pso;
+      auto it = pipeline_names.find(pso);
+      names += ' ';
+      names += it != pipeline_names.end() ? it->second : std::string("?");
+    }
+  }
+  return "draws=" + std::to_string(draws) + names;
+}
