 namespace dxmt {
 
+/* A frame waiting on a pipeline Metal is still compiling (compute, geometry and tessellation ones are never skipped,
+ * even with DXMT_ASYNC_PIPELINES): logged with the wall-clock time when the wait is long enough to be a visible hitch. */
+void
+WaitLogged(std::atomic_bool &ready, const char *kind, const std::string &name) {
+  if (ready.load(std::memory_order_acquire)) return;
+  auto t0 = std::chrono::steady_clock::now();
+  ready.wait(false, std::memory_order_acquire);
+  auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count();
+  if (ms < 20) return;
+  auto now = std::chrono::system_clock::now();
+  std::time_t tt = std::chrono::system_clock::to_time_t(now);
+  std::tm tm{};
+  localtime_s(&tm, &tt);
+  auto msec = std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count() % 1000;
+  WARN("pipeline wait: ", ms, " ms on ", kind, " ", name, " at ", str::format(std::put_time(&tm, "%H:%M:%S")), ".", msec);
+}
